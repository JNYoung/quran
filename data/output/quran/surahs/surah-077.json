{
  "surah_number": 77,
  "surah_name_arabic": "سُورَةُ المُرۡسَلَاتِ",
  "surah_name_english": "Al-Mursalaat",
  "surah_name_english_translation": "The Emissaries",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "77:1",
      "surah_number": 77,
      "ayah_number": 1,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا",
      "english_translation": "CONSIDER these [messages,] sent forth in waves"
    },
    {
      "ayah_reference": "77:2",
      "surah_number": 77,
      "ayah_number": 2,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا",
      "english_translation": "and then storming on with a tempest's force!"
    },
    {
      "ayah_reference": "77:3",
      "surah_number": 77,
      "ayah_number": 3,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا",
      "english_translation": "Consider these [messages] that spread [the truth] far and wide,"
    },
    {
      "ayah_reference": "77:4",
      "surah_number": 77,
      "ayah_number": 4,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا",
      "english_translation": "thus separating [right and wrong] with all clarity,"
    },
    {
      "ayah_reference": "77:5",
      "surah_number": 77,
      "ayah_number": 5,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "فَٱلْمُلْقِيَٰتِ ذِكْرًا",
      "english_translation": "and then giving forth a reminder,"
    },
    {
      "ayah_reference": "77:6",
      "surah_number": 77,
      "ayah_number": 6,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "عُذْرًا أَوْ نُذْرًا",
      "english_translation": "[promising] freedom from blame or [offering] a warning!"
    },
    {
      "ayah_reference": "77:7",
      "surah_number": 77,
      "ayah_number": 7,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ",
      "english_translation": "BEHOLD, all that you are told to expect will surely come to pass."
    },
    {
      "ayah_reference": "77:8",
      "surah_number": 77,
      "ayah_number": 8,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
      "english_translation": "Thus, [it will come to pass] when the stars are effaced,"
    },
    {
      "ayah_reference": "77:9",
      "surah_number": 77,
      "ayah_number": 9,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
      "english_translation": "and when the sky is rent asunder,"
    },
    {
      "ayah_reference": "77:10",
      "surah_number": 77,
      "ayah_number": 10,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
      "english_translation": "and when the mountains are scattered like dust,"
    },
    {
      "ayah_reference": "77:11",
      "surah_number": 77,
      "ayah_number": 11,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
      "english_translation": "and when all the apostles are called together at a time appointed..."
    },
    {
      "ayah_reference": "77:12",
      "surah_number": 77,
      "ayah_number": 12,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
      "english_translation": "For what day has the term [of all this] been set?"
    },
    {
      "ayah_reference": "77:13",
      "surah_number": 77,
      "ayah_number": 13,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "لِيَوْمِ ٱلْفَصْلِ",
      "english_translation": "For the Day of Distinction [between the true and the false]!"
    },
    {
      "ayah_reference": "77:14",
      "surah_number": 77,
      "ayah_number": 14,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
      "english_translation": "And what could make thee conceive what that Day of Distinction will be?"
    },
    {
      "ayah_reference": "77:15",
      "surah_number": 77,
      "ayah_number": 15,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "english_translation": "Woe on that Day unto those who give the lie to the truth!"
    },
    {
      "ayah_reference": "77:16",
      "surah_number": 77,
      "ayah_number": 16,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
      "english_translation": "Did We not destroy [so many of] those [sinners] of olden days?"
    },
    {
      "ayah_reference": "77:17",
      "surah_number": 77,
      "ayah_number": 17,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ",
      "english_translation": "And We shall let them be followed by those of later times:"
    },
    {
      "ayah_reference": "77:18",
      "surah_number": 77,
      "ayah_number": 18,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
      "english_translation": "[for] thus do We deal with such as are lost in sin."
    },
    {
      "ayah_reference": "77:19",
      "surah_number": 77,
      "ayah_number": 19,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 580,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "english_translation": "Woe on that Day unto those who give the lie to the truth!"
    },
    {
      "ayah_reference": "77:20",
      "surah_number": 77,
      "ayah_number": 20,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ",
      "english_translation": "Did We not create you out of a humble fluid"
    },
    {
      "ayah_reference": "77:21",
      "surah_number": 77,
      "ayah_number": 21,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ",
      "english_translation": "which We then let remain in [the womb's] firm keeping"
    },
    {
      "ayah_reference": "77:22",
      "surah_number": 77,
      "ayah_number": 22,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ",
      "english_translation": "for a term pre-ordained?"
    },
    {
      "ayah_reference": "77:23",
      "surah_number": 77,
      "ayah_number": 23,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ",
      "english_translation": "Thus have We determined [the nature of man's creation]: and excellent indeed is Our power to determine [what is to be]!"
    },
    {
      "ayah_reference": "77:24",
      "surah_number": 77,
      "ayah_number": 24,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "english_translation": "Woe, on that Day unto those who give the lie to the truth!"
    },
    {
      "ayah_reference": "77:25",
      "surah_number": 77,
      "ayah_number": 25,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "english_translation": "Have We not caused the earth to hold within itself"
    },
    {
      "ayah_reference": "77:26",
      "surah_number": 77,
      "ayah_number": 26,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "أَحْيَآءًۭ وَأَمْوَٰتًۭا",
      "english_translation": "the living and the dead?"
    },
    {
      "ayah_reference": "77:27",
      "surah_number": 77,
      "ayah_number": 27,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا",
      "english_translation": "and have We not set on it proud, firm mountains, and given you sweet water to drink?"
    },
    {
      "ayah_reference": "77:28",
      "surah_number": 77,
      "ayah_number": 28,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "english_translation": "Woe on that Day unto those who give the lie to the truth!"
    },
    {
      "ayah_reference": "77:29",
      "surah_number": 77,
      "ayah_number": 29,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "english_translation": "GO ON towards that [resurrection] which you were wont to call a lie!"
    },
    {
      "ayah_reference": "77:30",
      "surah_number": 77,
      "ayah_number": 30,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ",
      "english_translation": "Go on towards the threefold shadow"
    },
    {
      "ayah_reference": "77:31",
      "surah_number": 77,
      "ayah_number": 31,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "english_translation": "that will offer no [cooling] shade and will be of no avail against the flame"
    },
    {
      "ayah_reference": "77:32",
      "surah_number": 77,
      "ayah_number": 32,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ",
      "english_translation": "which – behold!- will throw up sparks like [burning] logs,"
    },
    {
      "ayah_reference": "77:33",
      "surah_number": 77,
      "ayah_number": 33,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ",
      "english_translation": "like giant fiery ropes!"
    },
    {
      "ayah_reference": "77:34",
      "surah_number": 77,
      "ayah_number": 34,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "english_translation": "Woe on that Day unto those who give the lie to the truth –"
    },
    {
      "ayah_reference": "77:35",
      "surah_number": 77,
      "ayah_number": 35,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "هَٰذَا يَوْمُ لَا يَنطِقُونَ",
      "english_translation": "that Day on which they will not [be able to] utter a word,"
    },
    {
      "ayah_reference": "77:36",
      "surah_number": 77,
      "ayah_number": 36,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
      "english_translation": "nor be allowed to proffer excuses!"
    },
    {
      "ayah_reference": "77:37",
      "surah_number": 77,
      "ayah_number": 37,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "english_translation": "Woe on that Day unto those who give the lie to the truth –"
    },
    {
      "ayah_reference": "77:38",
      "surah_number": 77,
      "ayah_number": 38,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ",
      "english_translation": "that Day of Distinction [between the true and the false, when they will be told]: \"We have brought you together with those [sinners] of olden times;"
    },
    {
      "ayah_reference": "77:39",
      "surah_number": 77,
      "ayah_number": 39,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ",
      "english_translation": "and if you [think that you] have a subterfuge left, try to outwit Me!\""
    },
    {
      "ayah_reference": "77:40",
      "surah_number": 77,
      "ayah_number": 40,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "sajda": false,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "english_translation": "Woe on that Day unto those who give the lie to the truth!"
    },
    {
      "ayah_reference": "77:41",
      "surah_number": 77,
      "ayah_number": 41,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "sajda": false,
      "arabic_text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ",
      "english_translation": "[AS AGAINST this,] behold, the God-conscious shall dwell amidst [cooling] shades and springs,"
    },
    {
      "ayah_reference": "77:42",
      "surah_number": 77,
      "ayah_number": 42,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "sajda": false,
      "arabic_text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
      "english_translation": "and [partake of] whatever fruit they may desire;"
    },
    {
      "ayah_reference": "77:43",
      "surah_number": 77,
      "ayah_number": 43,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "sajda": false,
      "arabic_text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "english_translation": "[and they will be told:] \"Eat and drink in good cheer in return for what you did [in life]!\""
    },
    {
      "ayah_reference": "77:44",
      "surah_number": 77,
      "ayah_number": 44,
      "juz": 29,
      "hizb_quarter": 232,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "sajda": false,
      "arabic_text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "english_translation": "Thus, behold, do We reward the doers of good;"
