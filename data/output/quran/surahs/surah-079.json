{
  "surah_number": 79,
  "surah_name_arabic": "سُورَةُ النَّازِعَاتِ",
  "surah_name_english": "An-Naazi'aat",
  "surah_name_english_translation": "Those who drag forth",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "79:1",
      "surah_number": 79,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا",
      "english_translation": "CONSIDER those [stars] that rise only to set,"
    },
    {
      "ayah_reference": "79:2",
      "surah_number": 79,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا",
      "english_translation": "and move [in their orbits] with steady motion,"
    },
    {
      "ayah_reference": "79:3",
      "surah_number": 79,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا",
      "english_translation": "and float [through space] with floating serene,"
    },
    {
      "ayah_reference": "79:4",
      "surah_number": 79,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا",
      "english_translation": "and yet overtake [one another] with swift overtaking:"
    },
    {
      "ayah_reference": "79:5",
      "surah_number": 79,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا",
      "english_translation": "and thus they fulfil the [Creator's] behest!"
    },
    {
      "ayah_reference": "79:6",
      "surah_number": 79,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "english_translation": "[HENCE, think of] the Day when a violent convulsion will convulse [the world],"
    },
    {
      "ayah_reference": "79:7",
      "surah_number": 79,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "english_translation": "to be followed by further [convulsions]!"
    },
    {
      "ayah_reference": "79:8",
      "surah_number": 79,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ",
      "english_translation": "On that Day will [men's] hearts be throbbing,"
    },
    {
      "ayah_reference": "79:9",
      "surah_number": 79,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "أَبْصَٰرُهَا خَٰشِعَةٌۭ",
      "english_translation": "[and] their eyes downcast..."
    },
    {
      "ayah_reference": "79:10",
      "surah_number": 79,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
      "english_translation": "[And yet,] some say, \"What! Are we indeed to be restored to our former state –"
    },
    {
      "ayah_reference": "79:11",
      "surah_number": 79,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ",
      "english_translation": "even though we may have become [a heap of] crumbling bones?\""
    },
    {
      "ayah_reference": "79:12",
      "surah_number": 79,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ",
      "english_translation": "[And] they add, \"That, then, would be a return with loss!\""
    },
    {
      "ayah_reference": "79:13",
      "surah_number": 79,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ",
      "english_translation": "[But,] then, that [Last Hour] will be [upon them of a sudden, as if it were] but a single accusing cry -"
    },
    {
      "ayah_reference": "79:14",
      "surah_number": 79,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
      "english_translation": "and then, lo, they will be fully awakened [to the truth]!"
    },
    {
      "ayah_reference": "79:15",
      "surah_number": 79,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "english_translation": "HAS THE STORY of Moses ever come within thy ken."
    },
    {
      "ayah_reference": "79:16",
      "surah_number": 79,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "english_translation": "Lo! His Sustainer called out to him in the twice-hallowed valley:"
    },
    {
      "ayah_reference": "79:17",
      "surah_number": 79,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "english_translation": "\"Go unto Pharaoh - for, verily, he has transgressed all bounds of what is right -"
    },
    {
      "ayah_reference": "79:18",
      "surah_number": 79,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
      "english_translation": "and say [unto him], 'Art thou desirous of attaining to purity?"
    },
    {
      "ayah_reference": "79:19",
      "surah_number": 79,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "english_translation": "[If so,] then I shall guide thee towards [a cognition of] thy Sustainer, so that [henceforth] thou wilt stand in awe [of Him].’\""
    },
    {
      "ayah_reference": "79:20",
      "surah_number": 79,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ",
      "english_translation": "And thereupon he [went to Pharaoh and] made him aware of the great wonder [of God's grace]."
    },
    {
      "ayah_reference": "79:21",
      "surah_number": 79,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَكَذَّبَ وَعَصَىٰ",
      "english_translation": "But [Pharaoh] gave him the lie and rebelliously rejected [all guidance],"
    },
    {
      "ayah_reference": "79:22",
      "surah_number": 79,
      "ayah_number": 22,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "english_translation": "and brusquely turned his back [on Moses];"
    },
    {
      "ayah_reference": "79:23",
      "surah_number": 79,
      "ayah_number": 23,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَحَشَرَ فَنَادَىٰ",
      "english_translation": "and then he gathered [his great ones], and called [unto his people],"
    },
    {
      "ayah_reference": "79:24",
      "surah_number": 79,
      "ayah_number": 24,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
      "english_translation": "and said, \"I am your Lord All-Highest!\""
    },
    {
      "ayah_reference": "79:25",
      "surah_number": 79,
      "ayah_number": 25,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ",
      "english_translation": "And thereupon God took him to task, [and made him] a warning example in the life to come as well as in this world."
    },
    {
      "ayah_reference": "79:26",
      "surah_number": 79,
      "ayah_number": 26,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "sajda": false,
      "arabic_text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ",
      "english_translation": "In this, behold, there is a lesson indeed for all who stand in awe [of God]."
    },
    {
      "ayah_reference": "79:27",
      "surah_number": 79,
      "ayah_number": 27,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "english_translation": "[O MEN!] Are you more difficult to create than the heaven which He has built?"
    },
    {
      "ayah_reference": "79:28",
      "surah_number": 79,
      "ayah_number": 28,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "english_translation": "High has He reared its vault and formed it in accordance with what it was meant to be;"
    },
    {
      "ayah_reference": "79:29",
      "surah_number": 79,
      "ayah_number": 29,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
      "english_translation": "and He has made dark its night and brought forth its light of day."
    },
    {
      "ayah_reference": "79:30",
      "surah_number": 79,
      "ayah_number": 30,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "english_translation": "And after that, the earth: wide has He spread its expanse,"
    },
    {
      "ayah_reference": "79:31",
      "surah_number": 79,
      "ayah_number": 31,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
      "english_translation": "and has caused its waters to come out of it, and its pastures,"
    },
    {
      "ayah_reference": "79:32",
      "surah_number": 79,
      "ayah_number": 32,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "وَٱلْجِبَالَ أَرْسَىٰهَا",
      "english_translation": "and has made the mountains firm:"
    },
    {
      "ayah_reference": "79:33",
      "surah_number": 79,
      "ayah_number": 33,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
      "english_translation": "[all this] as a means of livelihood for you and your animals."
    },
    {
      "ayah_reference": "79:34",
      "surah_number": 79,
      "ayah_number": 34,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
      "english_translation": "AND SO, when the great overwhelming event [of, resurrection] comes to pass –"
    },
    {
      "ayah_reference": "79:35",
      "surah_number": 79,
      "ayah_number": 35,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ",
      "english_translation": "on that Day man will [clearly] remember all that he has ever wrought;"
    },
    {
      "ayah_reference": "79:36",
      "surah_number": 79,
      "ayah_number": 36,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
      "english_translation": "and the blazing fire [of hell] will be lad open before all who [are destined to] see it."
    },
    {
      "ayah_reference": "79:37",
      "surah_number": 79,
      "ayah_number": 37,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "فَأَمَّا مَن طَغَىٰ",
      "english_translation": "For, unto him who shall have transgressed the bounds of what is right,"
    },
    {
      "ayah_reference": "79:38",
      "surah_number": 79,
      "ayah_number": 38,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "english_translation": "and preferred the life of this world [to the good of his soul],"
    },
    {
      "ayah_reference": "79:39",
      "surah_number": 79,
      "ayah_number": 39,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
      "english_translation": "that blazing fire will truly be the goal!"
    },
    {
      "ayah_reference": "79:40",
      "surah_number": 79,
      "ayah_number": 40,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
      "english_translation": "But unto him who shall have stood in fear of his Sustainer's Presence, and held back his inner self from base desires,"
    },
    {
      "ayah_reference": "79:41",
      "surah_number": 79,
      "ayah_number": 41,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
      "english_translation": "paradise will truly be the goal!"
    },
    {
      "ayah_reference": "79:42",
      "surah_number": 79,
      "ayah_number": 42,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
      "english_translation": "THEY WILL ASK thee [O Prophet] about the Last Hour: \"When will it come to pass?\""
    },
    {
      "ayah_reference": "79:43",
      "surah_number": 79,
      "ayah_number": 43,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
      "arabic_text": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
      "english_translation": "[But] how couldst thou tell anything about it,"
    },
    {
      "ayah_reference": "79:44",
      "surah_number": 79,
      "ayah_number": 44,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "sajda": false,
