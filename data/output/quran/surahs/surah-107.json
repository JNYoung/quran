{
  "surah_number": 107,
  "surah_name_arabic": "سُورَةُ المَاعُونِ",
  "surah_name_english": "Al-Maa'un",
  "surah_name_english_translation": "Almsgiving",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "107:1",
      "surah_number": 107,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
      "english_translation": "HAST THOU ever considered [the kind of man] who gives the lie to all moral law?"
    },
    {
      "ayah_reference": "107:2",
      "surah_number": 107,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "sajda": false,
      "arabic_text": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
      "english_translation": "Behold, it is this [kind of man] that thrusts the orphan away,"
    },
    {
      "ayah_reference": "107:3",
      "surah_number": 107,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "sajda": false,
      "arabic_text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "english_translation": "and feels no urge to feed the needy."
    },
    {
      "ayah_reference": "107:4",
      "surah_number": 107,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "sajda": false,
      "arabic_text": "فَوَيْلٌۭ لِّلْمُصَلِّينَ",
      "english_translation": "Woe, then, unto those praying ones"
    },
    {
      "ayah_reference": "107:5",
      "surah_number": 107,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "sajda": false,
      "arabic_text": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "english_translation": "whose hearts from their prayer are remote"
    },
    {
      "ayah_reference": "107:6",
      "surah_number": 107,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "sajda": false,
      "arabic_text": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
      "english_translation": "those who want only to be seen and praised,"
    },
    {
      "ayah_reference": "107:7",
      "surah_number": 107,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "sajda": false,
      "arabic_text": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
      "english_translation": "and, withal, deny all assistance [to their fellow-men]!"
    }
  ]
}