{
  "surah_number": 94,
  "surah_name_arabic": "سُورَةُ الشَّرۡحِ",
  "surah_name_english": "Ash-Sharh",
  "surah_name_english_translation": "The Consolation",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "94:1",
      "surah_number": 94,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
      "english_translation": "HAVE WE NOT opened up thy heart,"
    },
    {
      "ayah_reference": "94:2",
      "surah_number": 94,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "sajda": false,
      "arabic_text": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
      "english_translation": "and lifted from thee the burden"
    },
    {
      "ayah_reference": "94:3",
      "surah_number": 94,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "sajda": false,
      "arabic_text": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
      "english_translation": "that had weighed so heavily on thy back?"
    },
    {
      "ayah_reference": "94:4",
      "surah_number": 94,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "sajda": false,
      "arabic_text": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
      "english_translation": "And [have We not] raised thee high in dignity?"
    },
    {
      "ayah_reference": "94:5",
      "surah_number": 94,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "sajda": false,
      "arabic_text": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "english_translation": "And, behold, with every hardship comes ease:"
    },
    {
      "ayah_reference": "94:6",
      "surah_number": 94,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "sajda": false,
      "arabic_text": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا",
      "english_translation": "verily, with every hardship comes ease!"
    },
    {
      "ayah_reference": "94:7",
      "surah_number": 94,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "sajda": false,
      "arabic_text": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
      "english_translation": "Hence, when thou art freed [from distress], remain steadfast,"
    },
    {
      "ayah_reference": "94:8",
      "surah_number": 94,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "sajda": false,
      "arabic_text": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
      "english_translation": "and unto thy Sustainer turn with love."
    }
  ]
}