{
  "surah_number": 104,
  "surah_name_arabic": "سُورَةُ الهُمَزَةِ",
  "surah_name_english": "Al-Humaza",
  "surah_name_english_translation": "The Traducer",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "104:1",
      "surah_number": 104,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ",
      "english_translation": "WOE unto every slanderer, fault-finder!"
    },
    {
      "ayah_reference": "104:2",
      "surah_number": 104,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ",
      "english_translation": "[Woe unto him who amasses wealth and counts it a safeguard,"
    },
    {
      "ayah_reference": "104:3",
      "surah_number": 104,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "english_translation": "thinking that his wealth will make him live forever!"
    },
    {
      "ayah_reference": "104:4",
      "surah_number": 104,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "english_translation": "Nay, but [in the life to come such as] he shall indeed be abandoned to crushing torment!"
    },
    {
      "ayah_reference": "104:5",
      "surah_number": 104,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "english_translation": "And what could make thee conceive what that crushing torment will be?"
    },
    {
      "ayah_reference": "104:6",
      "surah_number": 104,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "english_translation": "A fire kindled by God,"
    },
    {
      "ayah_reference": "104:7",
      "surah_number": 104,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "english_translation": "which will rise over the [guilty] hearts:"
    },
    {
      "ayah_reference": "104:8",
      "surah_number": 104,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ",
      "english_translation": "verily, it will close in upon them"
    },
    {
      "ayah_reference": "104:9",
      "surah_number": 104,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "sajda": false,
      "arabic_text": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ",
      "english_translation": "in endless columns!"
    }
  ]
}