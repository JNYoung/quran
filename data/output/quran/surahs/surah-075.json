{
  "surah_number": 75,
  "surah_name_arabic": "سُورَةُ القِيَامَةِ",
  "surah_name_english": "Al-Qiyaama",
  "surah_name_english_translation": "The Resurrection",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "75:1",
      "surah_number": 75,
      "ayah_number": 1,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ",
      "english_translation": "NAY! I call to witness the Day of Resurrection!"
    },
    {
      "ayah_reference": "75:2",
      "surah_number": 75,
      "ayah_number": 2,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "english_translation": "But nay! I call to witness the accusing voice of man's own conscience!"
    },
    {
      "ayah_reference": "75:3",
      "surah_number": 75,
      "ayah_number": 3,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "english_translation": "Does man think that We cannot [resurrect him and] bring his bones together again?"
    },
    {
      "ayah_reference": "75:4",
      "surah_number": 75,
      "ayah_number": 4,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "english_translation": "Yea indeed, We are able to make whole his very finger-tips!"
    },
    {
      "ayah_reference": "75:5",
      "surah_number": 75,
      "ayah_number": 5,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "english_translation": "None the less man chooses to deny what lies ahead of him,"
    },
    {
      "ayah_reference": "75:6",
      "surah_number": 75,
      "ayah_number": 6,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ",
      "english_translation": "asking [derisively], \"When is that Resurrection Day to be?\""
    },
    {
      "ayah_reference": "75:7",
      "surah_number": 75,
      "ayah_number": 7,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "english_translation": "But [on that Day,] when the eyesight is by fear confounded,"
    },
    {
      "ayah_reference": "75:8",
      "surah_number": 75,
      "ayah_number": 8,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَخَسَفَ ٱلْقَمَرُ",
      "english_translation": "and the moon is darkened,"
    },
    {
      "ayah_reference": "75:9",
      "surah_number": 75,
      "ayah_number": 9,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "english_translation": "and the sun and the moon are brought together"
    },
    {
      "ayah_reference": "75:10",
      "surah_number": 75,
      "ayah_number": 10,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "english_translation": "on that Day will man exclaim \"Whither to flee?\""
    },
    {
      "ayah_reference": "75:11",
      "surah_number": 75,
      "ayah_number": 11,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "كَلَّا لَا وَزَرَ",
      "english_translation": "But nay: no refuge [for thee, O man]!"
    },
    {
      "ayah_reference": "75:12",
      "surah_number": 75,
      "ayah_number": 12,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "english_translation": "With thy Sustainer, on that Day, the journey's end will be!"
    },
    {
      "ayah_reference": "75:13",
      "surah_number": 75,
      "ayah_number": 13,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "english_translation": "Man will be apprised, on that Day, of what he has done and what he has left undone:"
    },
    {
      "ayah_reference": "75:14",
      "surah_number": 75,
      "ayah_number": 14,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ",
      "english_translation": "nay, but man shall against himself be an eye-witness,"
    },
    {
      "ayah_reference": "75:15",
      "surah_number": 75,
      "ayah_number": 15,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "english_translation": "even though he may veil himself in excuses."
    },
    {
      "ayah_reference": "75:16",
      "surah_number": 75,
      "ayah_number": 16,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "english_translation": "MOVE NOT thy tongue in haste, [repeating the words of the revelation:]"
    },
    {
      "ayah_reference": "75:17",
      "surah_number": 75,
      "ayah_number": 17,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "english_translation": "for, behold, it is for Us to gather it [in thy heart,] and to cause it to be read [as it ought to be read]."
    },
    {
      "ayah_reference": "75:18",
      "surah_number": 75,
      "ayah_number": 18,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "english_translation": "Thus, when We recite it, follow thou its wording [with all thy mind]:"
    },
    {
      "ayah_reference": "75:19",
      "surah_number": 75,
      "ayah_number": 19,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "english_translation": "and then, behold, it will be for Us to make its meaning clear."
    },
    {
      "ayah_reference": "75:20",
      "surah_number": 75,
      "ayah_number": 20,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "english_translation": "NAY, but [most of] you love this fleeting life,"
    },
    {
      "ayah_reference": "75:21",
      "surah_number": 75,
      "ayah_number": 21,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَتَذَرُونَ ٱلْءَاخِرَةَ",
      "english_translation": "and give no thought to the life to come [and to Judgment Day]!"
    },
    {
      "ayah_reference": "75:22",
      "surah_number": 75,
      "ayah_number": 22,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ",
      "english_translation": "Some faces will on that Day be bright with happiness,"
    },
    {
      "ayah_reference": "75:23",
      "surah_number": 75,
      "ayah_number": 23,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ",
      "english_translation": "looking up to their Sustainer;"
    },
    {
      "ayah_reference": "75:24",
      "surah_number": 75,
      "ayah_number": 24,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ",
      "english_translation": "and some faces will on that Day be overcast with despair,"
    },
    {
      "ayah_reference": "75:25",
      "surah_number": 75,
      "ayah_number": 25,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ",
      "english_translation": "knowing that a crushing calamity is about to befall them."
    },
    {
      "ayah_reference": "75:26",
      "surah_number": 75,
      "ayah_number": 26,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "english_translation": "NAY, but when [the last breath] comes up to the throat [of a dying man],"
    },
    {
      "ayah_reference": "75:27",
      "surah_number": 75,
      "ayah_number": 27,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَقِيلَ مَنْ ۜ رَاقٍۢ",
      "english_translation": "and people ask, \"Is there any wizard [that could save him]?\""
    },
    {
      "ayah_reference": "75:28",
      "surah_number": 75,
      "ayah_number": 28,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
      "english_translation": "the while he [himself] knows that this is the parting,"
    },
    {
      "ayah_reference": "75:29",
      "surah_number": 75,
      "ayah_number": 29,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "english_translation": "and is enwrapped in the pangs of death"
    },
    {
      "ayah_reference": "75:30",
      "surah_number": 75,
      "ayah_number": 30,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "sajda": false,
      "arabic_text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
      "english_translation": "at that time towards thy Sustainer does he feel impelled to turn!"
    },
    {
      "ayah_reference": "75:31",
      "surah_number": 75,
      "ayah_number": 31,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "english_translation": "[Useless, though, will be his repentance: for [as long as he was alive] he did not accept the truth, nor did he pray [for enlightenment],"
    },
    {
      "ayah_reference": "75:32",
      "surah_number": 75,
      "ayah_number": 32,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "english_translation": "but, on the contrary, he gave the lie to the truth and turned away [from it],"
    },
    {
      "ayah_reference": "75:33",
      "surah_number": 75,
      "ayah_number": 33,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
      "english_translation": "and then went arrogantly back to what he had come from."
    },
    {
      "ayah_reference": "75:34",
      "surah_number": 75,
      "ayah_number": 34,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
      "english_translation": "[And yet, O man, thine end comes hourly] nearer unto thee, and nearer –"
    },
    {
      "ayah_reference": "75:35",
      "surah_number": 75,
      "ayah_number": 35,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
      "english_translation": "and ever nearer unto thee, and nearer!"
    },
    {
      "ayah_reference": "75:36",
      "surah_number": 75,
      "ayah_number": 36,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى",
      "english_translation": "DOES MAN, then, think that he is to be left to himself to go about at will?"
    },
    {
      "ayah_reference": "75:37",
      "surah_number": 75,
      "ayah_number": 37,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ",
      "english_translation": "Was he not once a [mere] drop of sperm that had been spilt,"
    },
    {
      "ayah_reference": "75:38",
      "surah_number": 75,
      "ayah_number": 38,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ",
      "english_translation": "and thereafter became a germ-cell - whereupon He created and formed [it] in accordance with what [it] was meant to be,"
    },
    {
      "ayah_reference": "75:39",
      "surah_number": 75,
      "ayah_number": 39,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "english_translation": "and fashioned out of it the two sexes, the male and the female?"
    },
    {
      "ayah_reference": "75:40",
      "surah_number": 75,
      "ayah_number": 40,
      "juz": 29,
      "hizb_quarter": 231,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "sajda": false,
      "arabic_text": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ",
      "english_translation": "Is not He, then; able to bring the dead back to life?"
    }
  ]
}