{
  "surah_number": 90,
  "surah_name_arabic": "سُورَةُ البَلَدِ",
  "surah_name_english": "Al-Balad",
  "surah_name_english_translation": "The City",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "90:1",
      "surah_number": 90,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ",
      "english_translation": "NAY! I call to witness this land –"
    },
    {
      "ayah_reference": "90:2",
      "surah_number": 90,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ",
      "english_translation": "this land in which thou art free to dwell -"
    },
    {
      "ayah_reference": "90:3",
      "surah_number": 90,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "وَوَالِدٍۢ وَمَا وَلَدَ",
      "english_translation": "and [I call to witness] parent and offspring:"
    },
    {
      "ayah_reference": "90:4",
      "surah_number": 90,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ",
      "english_translation": "Verily, We have created man into [a life of] pain, toil and trial."
    },
    {
      "ayah_reference": "90:5",
      "surah_number": 90,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ",
      "english_translation": "Does he, then, think that no one has power over him?"
    },
    {
      "ayah_reference": "90:6",
      "surah_number": 90,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا",
      "english_translation": "He boasts, \"I have spent wealth abundant!\""
    },
    {
      "ayah_reference": "90:7",
      "surah_number": 90,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
      "english_translation": "Does he, then, think that no one sees him?"
    },
    {
      "ayah_reference": "90:8",
      "surah_number": 90,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
      "english_translation": "Have We not given him two eyes,"
    },
    {
      "ayah_reference": "90:9",
      "surah_number": 90,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "وَلِسَانًۭا وَشَفَتَيْنِ",
      "english_translation": "and a tongue, and a pair of lips,"
    },
    {
      "ayah_reference": "90:10",
      "surah_number": 90,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ",
      "english_translation": "and shown him the two highways [of good and evil]?"
    },
    {
      "ayah_reference": "90:11",
      "surah_number": 90,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
      "english_translation": "But he would not try to ascend the steep uphill road..."
    },
    {
      "ayah_reference": "90:12",
      "surah_number": 90,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
      "english_translation": "And what could make thee conceive what it is, that steep uphill road?"
    },
    {
      "ayah_reference": "90:13",
      "surah_number": 90,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "فَكُّ رَقَبَةٍ",
      "english_translation": "[It is] the freeing of one's neck [from the burden of sin],"
    },
    {
      "ayah_reference": "90:14",
      "surah_number": 90,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ",
      "english_translation": "or the feeding, upon a day of [one's own] hunger,"
    },
    {
      "ayah_reference": "90:15",
      "surah_number": 90,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "يَتِيمًۭا ذَا مَقْرَبَةٍ",
      "english_translation": "of an orphan near of kin,"
    },
    {
      "ayah_reference": "90:16",
      "surah_number": 90,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ",
      "english_translation": "or of a needy [stranger] lying in the dust –"
    },
    {
      "ayah_reference": "90:17",
      "surah_number": 90,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
      "english_translation": "and being, withal, of those who have attained to faith, and who enjoin upon one another patience in adversity, and enjoin upon one another compassion."
    },
    {
      "ayah_reference": "90:18",
      "surah_number": 90,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ",
      "english_translation": "Such are they that have attained to righteousness;"
    },
    {
      "ayah_reference": "90:19",
      "surah_number": 90,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",
      "english_translation": "whereas those who are bent on denying the truth of Our messages – they are such as have lost themselves in evil,"
    },
    {
      "ayah_reference": "90:20",
      "surah_number": 90,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 594,
      "ruku": 532,
      "sajda": false,
      "arabic_text": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ",
      "english_translation": "[with] fire closing in upon them."
    }
  ]
}