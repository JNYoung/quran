      "ayah_reference": "1:3",
      "surah_number": 1,
      "ayah_number": 3,
      "juz": 1,
      "hizb_quarter": 1,
      "manzil": 1,
      "page": 1,
      "ruku": 1,
      "sajda": false,
      "arabic_text": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ",
      "english_translation": "The Most Gracious, the Dispenser of Grace,"
    },
    {
      "ayah_reference": "1:4",
      "surah_number": 1,
      "ayah_number": 4,
      "juz": 1,
      "hizb_quarter": 1,
      "manzil": 1,
      "page": 1,
      "ruku": 1,
      "sajda": false,
      "arabic_text": "مَٰلِكِ يَوْمِ ٱلدِّينِ",
      "english_translation": "Lord of the Day of Judgment!"
    },
    {
      "ayah_reference": "1:5",
      "surah_number": 1,
      "ayah_number": 5,
      "juz": 1,
      "hizb_quarter": 1,
      "manzil": 1,
      "page": 1,
      "ruku": 1,
      "sajda": false,
      "arabic_text": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
      "english_translation": "Thee alone do we worship; and unto Thee alone do we turn for aid."
    },
    {
      "ayah_reference": "1:6",
      "surah_number": 1,
      "ayah_number": 6,
      "juz": 1,
      "hizb_quarter": 1,
      "manzil": 1,
      "page": 1,
      "ruku": 1,
      "sajda": false,
      "arabic_text": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
      "english_translation": "Guide us the straight way."
    },
    {
      "ayah_reference": "1:7",
      "surah_number": 1,
      "ayah_number": 7,
      "juz": 1,
      "hizb_quarter": 1,
      "manzil": 1,
      "page": 1,
      "ruku": 1,
      "sajda": false,
      "arabic_text": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
      "english_translation": "The way of those upon whom Thou hast bestowed Thy blessings, not of those who have been condemned [by Thee], nor of those who go astray!"
    }
  ]
