      "surah_number": 1,
      "ayah_number": 2,
      "juz": 1,
      "hizb_quarter": 1,
      "manzil": 1,
      "page": 1,
      "ruku": 1,
      "sajda": false,
      "arabic_text": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ",
      "english_translation": "All praise is due to God alone, the Sustainer of all the worlds,"
