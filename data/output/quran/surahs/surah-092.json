{
  "surah_number": 92,
  "surah_name_arabic": "سُورَةُ اللَّيۡلِ",
  "surah_name_english": "Al-Lail",
  "surah_name_english_translation": "The Night",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "92:1",
      "surah_number": 92,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "english_translation": "CONSIDER the night as it veils [the earth] in darkness,"
    },
    {
      "ayah_reference": "92:2",
      "surah_number": 92,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "english_translation": "and the day as it rises bright!"
    },
    {
      "ayah_reference": "92:3",
      "surah_number": 92,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "english_translation": "Consider the creation of the male and the female!"
    },
    {
      "ayah_reference": "92:4",
      "surah_number": 92,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "english_translation": "Verily, [O men,] you aim at most divergent ends!"
    },
    {
      "ayah_reference": "92:5",
      "surah_number": 92,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "english_translation": "Thus, as for him who gives [to others] and is conscious of God,"
    },
    {
      "ayah_reference": "92:6",
      "surah_number": 92,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "english_translation": "and believes in the truth of the ultimate good"
    },
    {
      "ayah_reference": "92:7",
      "surah_number": 92,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "english_translation": "for him shall We make easy the path towards [ultimate] ease."
    },
    {
      "ayah_reference": "92:8",
      "surah_number": 92,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "english_translation": "But as for him who is niggardly, and thinks that he is self-sufficient,"
    },
    {
      "ayah_reference": "92:9",
      "surah_number": 92,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "english_translation": "and calls the ultimate good a lie –"
    },
    {
      "ayah_reference": "92:10",
      "surah_number": 92,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "english_translation": "for him shall We make easy the path towards hardship:"
    },
    {
      "ayah_reference": "92:11",
      "surah_number": 92,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "english_translation": "and what will his wealth avail him when he goes down [to his grave]?"
    },
    {
      "ayah_reference": "92:12",
      "surah_number": 92,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "english_translation": "BEHOLD, it is indeed for Us to grace [you] with guidance;"
    },
    {
      "ayah_reference": "92:13",
      "surah_number": 92,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ",
      "english_translation": "and, behold, Ours is [the dominion over] the life to come as well as [over] this earlier part [of your life]:"
    },
    {
      "ayah_reference": "92:14",
      "surah_number": 92,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ",
      "english_translation": "and so I warn you of the raging fire -"
    },
    {
      "ayah_reference": "92:15",
      "surah_number": 92,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "english_translation": "[the fire] which none shall have to endure but that most hapless wretch"
    },
    {
      "ayah_reference": "92:16",
      "surah_number": 92,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "english_translation": "who gives the lie to the truth and turns away [from it]."
    },
    {
      "ayah_reference": "92:17",
      "surah_number": 92,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "english_translation": "For, distant from it shall remain he who is truly conscious of God:"
    },
    {
      "ayah_reference": "92:18",
      "surah_number": 92,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "english_translation": "he that spends his possessions [on others] so that he might grow in purity –"
    },
    {
      "ayah_reference": "92:19",
      "surah_number": 92,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ",
      "english_translation": "not as payment for favours received,"
    },
    {
      "ayah_reference": "92:20",
      "surah_number": 92,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "english_translation": "but only out of a longing for the countenance of his Sustainer, the All-Highest:"
    },
    {
      "ayah_reference": "92:21",
      "surah_number": 92,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "sajda": false,
      "arabic_text": "وَلَسَوْفَ يَرْضَىٰ",
      "english_translation": "and such, indeed, shall in time be well-pleased."
    }
  ]
}