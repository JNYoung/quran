{
  "surah_number": 95,
  "surah_name_arabic": "سُورَةُ التِّينِ",
  "surah_name_english": "At-Tin",
  "surah_name_english_translation": "The Fig",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "95:1",
      "surah_number": 95,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "sajda": false,
      "arabic_text": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ",
      "english_translation": "CONSIDER the fig and the olive,"
    },
    {
      "ayah_reference": "95:2",
      "surah_number": 95,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "sajda": false,
      "arabic_text": "وَطُورِ سِينِينَ",
      "english_translation": "and Mount Sinai,"
    },
    {
      "ayah_reference": "95:3",
      "surah_number": 95,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "sajda": false,
      "arabic_text": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
      "english_translation": "and this land secure!"
    },
    {
      "ayah_reference": "95:4",
      "surah_number": 95,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "sajda": false,
      "arabic_text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ",
      "english_translation": "Verily, We create man in the best conformation;"
    },
    {
      "ayah_reference": "95:5",
      "surah_number": 95,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "sajda": false,
      "arabic_text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ",
      "english_translation": "and thereafter We reduce him to the lowest of low"
    },
    {
      "ayah_reference": "95:6",
      "surah_number": 95,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "sajda": false,
      "arabic_text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ",
      "english_translation": "excepting only such as attain to faith and do good works: and theirs shall be a reward unending!"
    },
    {
      "ayah_reference": "95:7",
      "surah_number": 95,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "sajda": false,
      "arabic_text": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
      "english_translation": "What, then, [O man,] could henceforth cause thee to give the lie to this moral law?"
    },
    {
      "ayah_reference": "95:8",
      "surah_number": 95,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "sajda": false,
      "arabic_text": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ",
      "english_translation": "Is not God the most just of judges?"
    }
  ]
}