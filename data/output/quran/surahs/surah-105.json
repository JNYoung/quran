{
  "surah_number": 105,
  "surah_name_arabic": "سُورَةُ الفِيلِ",
  "surah_name_english": "Al-Fil",
  "surah_name_english_translation": "The Elephant",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "105:1",
