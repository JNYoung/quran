{
  "surah_number": 86,
  "surah_name_arabic": "سُورَةُ الطَّارِقِ",
  "surah_name_english": "At-Taariq",
  "surah_name_english_translation": "The Morning Star",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "86:1",
      "surah_number": 86,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "english_translation": "CONSIDER the heavens and that which comes in the night!"
    },
    {
      "ayah_reference": "86:2",
      "surah_number": 86,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
      "english_translation": "And what could make thee conceive what it is that comes in the night?"
    },
    {
      "ayah_reference": "86:3",
      "surah_number": 86,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "english_translation": "It is the star that pierces through [life's] darkness:"
    },
    {
      "ayah_reference": "86:4",
      "surah_number": 86,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ",
      "english_translation": "[for] no human being has ever been left unguarded."
    },
    {
      "ayah_reference": "86:5",
      "surah_number": 86,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ",
      "english_translation": "LET MAN, then, observe out of what he has been created:"
    },
    {
      "ayah_reference": "86:6",
      "surah_number": 86,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ",
      "english_translation": "he has been created out of a seminal fluid"
    },
    {
      "ayah_reference": "86:7",
      "surah_number": 86,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
      "english_translation": "issuing from between the loins [of man] and the pelvic arch [of woman]."
    },
    {
      "ayah_reference": "86:8",
      "surah_number": 86,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ",
      "english_translation": "Now, verily, He [who thus creates man in the first instance] is well able to bring him back [to life]"
    },
    {
      "ayah_reference": "86:9",
      "surah_number": 86,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
      "english_translation": "on the Day when all secrets will be laid bare,"
    },
    {
      "ayah_reference": "86:10",
      "surah_number": 86,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ",
      "english_translation": "and [man] will have neither strength nor helper!"
    },
    {
      "ayah_reference": "86:11",
      "surah_number": 86,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
      "english_translation": "Consider the heavens, ever-revolving,"
    },
    {
      "ayah_reference": "86:12",
      "surah_number": 86,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
      "english_translation": "and the earth, bursting forth with plants!"
    },
    {
      "ayah_reference": "86:13",
      "surah_number": 86,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ",
      "english_translation": "BEHOLD, this [divine writ] is indeed a word that between truth and falsehood,"
    },
    {
      "ayah_reference": "86:14",
      "surah_number": 86,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "وَمَا هُوَ بِٱلْهَزْلِ",
      "english_translation": "and is no idle tale."
    },
    {
      "ayah_reference": "86:15",
      "surah_number": 86,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا",
      "english_translation": "Behold, they [who refuse to accept it] devise many a false argument [to disprove its truth];"
    },
    {
      "ayah_reference": "86:16",
      "surah_number": 86,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "وَأَكِيدُ كَيْدًۭا",
      "english_translation": "but I shall bring all their scheming to nought."
    },
    {
      "ayah_reference": "86:17",
      "surah_number": 86,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "sajda": false,
      "arabic_text": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
      "english_translation": "Let, then, the deniers of the truth have their will: let them have their will for a little while."
    }
  ]
}