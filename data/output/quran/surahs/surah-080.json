{
  "surah_number": 80,
  "surah_name_arabic": "سُورَةُ عَبَسَ",
  "surah_name_english": "Abasa",
  "surah_name_english_translation": "He frowned",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "80:1",
      "surah_number": 80,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ",
      "english_translation": "HE FROWNED and turned away"
    },
    {
      "ayah_reference": "80:2",
      "surah_number": 80,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "english_translation": "because the blind man approached him!"
    },
    {
      "ayah_reference": "80:3",
      "surah_number": 80,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "english_translation": "Yet for all thou didst know, [O Muhammad,] he might perhaps have grown in purity,"
    },
    {
      "ayah_reference": "80:4",
      "surah_number": 80,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "english_translation": "or have been reminded [of the truth], and helped by this reminder."
    },
    {
      "ayah_reference": "80:5",
      "surah_number": 80,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "english_translation": "Now as for him who believes himself to be self-sufficient"
    },
    {
      "ayah_reference": "80:6",
      "surah_number": 80,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "english_translation": "to him didst thou give thy whole attention,"
    },
    {
      "ayah_reference": "80:7",
      "surah_number": 80,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "english_translation": "although thou art not accountable for his failure to attain to purity;"
    },
    {
      "ayah_reference": "80:8",
      "surah_number": 80,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "english_translation": "but as for him who came unto thee full of eagerness"
    },
    {
      "ayah_reference": "80:9",
      "surah_number": 80,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَهُوَ يَخْشَىٰ",
      "english_translation": "and in awe [of God]"
    },
    {
      "ayah_reference": "80:10",
      "surah_number": 80,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "english_translation": "him didst thou disregard!"
    },
    {
      "ayah_reference": "80:11",
      "surah_number": 80,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ",
      "english_translation": "NAY, VERILY, these [messages] are but a reminder:"
    },
    {
      "ayah_reference": "80:12",
      "surah_number": 80,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "فَمَن شَآءَ ذَكَرَهُۥ",
      "english_translation": "and so, whoever is willing may remember Him"
    },
    {
      "ayah_reference": "80:13",
      "surah_number": 80,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ",
      "english_translation": "in [the light of His] revelations blest with dignity,"
    },
    {
      "ayah_reference": "80:14",
      "surah_number": 80,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ",
      "english_translation": "lofty and pure,"
    },
    {
      "ayah_reference": "80:15",
      "surah_number": 80,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "بِأَيْدِى سَفَرَةٍۢ",
      "english_translation": "[borne] by the hands of messengers"
    },
    {
      "ayah_reference": "80:16",
      "surah_number": 80,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "كِرَامٍۭ بَرَرَةٍۢ",
      "english_translation": "noble and most virtuous."
    },
    {
      "ayah_reference": "80:17",
      "surah_number": 80,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",
      "english_translation": "[But only too often] man destroys himself: how stubbornly does he deny the truth!"
    },
    {
      "ayah_reference": "80:18",
      "surah_number": 80,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "english_translation": "[Does man ever consider] out of what substance [God] creates him?"
    },
    {
      "ayah_reference": "80:19",
      "surah_number": 80,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "english_translation": "Out of a drop of sperm He creates him, and thereupon determines his nature,"
    },
    {
      "ayah_reference": "80:20",
      "surah_number": 80,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "english_translation": "and then makes it easy for him to go through life;"
    },
    {
      "ayah_reference": "80:21",
      "surah_number": 80,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "english_translation": "and in the end He causes him to die and brings him to the grave;"
    },
    {
      "ayah_reference": "80:22",
      "surah_number": 80,
      "ayah_number": 22,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "english_translation": "and then, if it be His will, He shall raise him again to life,"
    },
    {
      "ayah_reference": "80:23",
      "surah_number": 80,
      "ayah_number": 23,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "english_translation": "Nay, but [man] has never yet fulfilled what He has enjoined upon him!"
    },
    {
      "ayah_reference": "80:24",
      "surah_number": 80,
      "ayah_number": 24,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "english_translation": "Let man, then, consider [the sources of] his food:"
    },
    {
      "ayah_reference": "80:25",
      "surah_number": 80,
      "ayah_number": 25,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا",
      "english_translation": "[how it is] that We pour down water, pouring it down abundantly;"
    },
    {
      "ayah_reference": "80:26",
      "surah_number": 80,
      "ayah_number": 26,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا",
      "english_translation": "and then We cleave the earth [with new growth], cleaving it asunder,"
    },
    {
      "ayah_reference": "80:27",
      "surah_number": 80,
      "ayah_number": 27,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا",
      "english_translation": "and thereupon We cause grain to grow out of it,"
    },
    {
      "ayah_reference": "80:28",
      "surah_number": 80,
      "ayah_number": 28,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَعِنَبًۭا وَقَضْبًۭا",
      "english_translation": "and vines and edible plants,"
    },
    {
      "ayah_reference": "80:29",
      "surah_number": 80,
      "ayah_number": 29,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَزَيْتُونًۭا وَنَخْلًۭا",
      "english_translation": "and olive trees and date-palms,"
    },
    {
      "ayah_reference": "80:30",
      "surah_number": 80,
      "ayah_number": 30,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَحَدَآئِقَ غُلْبًۭا",
      "english_translation": "and gardens dense with foliage,"
    },
    {
      "ayah_reference": "80:31",
      "surah_number": 80,
      "ayah_number": 31,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَفَٰكِهَةًۭ وَأَبًّۭا",
      "english_translation": "and fruits and herbage,"
    },
    {
      "ayah_reference": "80:32",
      "surah_number": 80,
      "ayah_number": 32,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
      "english_translation": "for you and for your animals to enjoy."
    },
    {
      "ayah_reference": "80:33",
      "surah_number": 80,
      "ayah_number": 33,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "english_translation": "AND SO, when the piercing call [of resurrection] is heard"
    },
    {
      "ayah_reference": "80:34",
      "surah_number": 80,
      "ayah_number": 34,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "english_translation": "on a Day when everyone will [want to] flee from his brother,"
    },
    {
      "ayah_reference": "80:35",
      "surah_number": 80,
      "ayah_number": 35,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَأُمِّهِۦ وَأَبِيهِ",
      "english_translation": "and from his mother and father,"
    },
    {
      "ayah_reference": "80:36",
      "surah_number": 80,
      "ayah_number": 36,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
      "english_translation": "and from his spouse and his children:"
    },
    {
      "ayah_reference": "80:37",
      "surah_number": 80,
      "ayah_number": 37,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ",
      "english_translation": "on that Day, to every one of them will his own state be of sufficient concern."
    },
    {
      "ayah_reference": "80:38",
      "surah_number": 80,
      "ayah_number": 38,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ",
      "english_translation": "Some faces will on that Day be bright with happiness,"
    },
    {
      "ayah_reference": "80:39",
      "surah_number": 80,
      "ayah_number": 39,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ",
      "english_translation": "laughing, rejoicing at glad tidings."
    },
    {
      "ayah_reference": "80:40",
      "surah_number": 80,
      "ayah_number": 40,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ",
      "english_translation": "And some faces will on that Day with dust be covered,"
    },
    {
      "ayah_reference": "80:41",
      "surah_number": 80,
      "ayah_number": 41,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "تَرْهَقُهَا قَتَرَةٌ",
      "english_translation": "with darkness overspread:"
    },
    {
      "ayah_reference": "80:42",
      "surah_number": 80,
      "ayah_number": 42,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "sajda": false,
      "arabic_text": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "english_translation": "these, these will be the ones who denied the truth and were immersed in iniquity!"
    }
  ]
}