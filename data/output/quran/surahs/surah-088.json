{
  "surah_number": 88,
  "surah_name_arabic": "سُورَةُ الغَاشِيَةِ",
  "surah_name_english": "Al-Ghaashiya",
  "surah_name_english_translation": "The Overwhelming",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "88:1",
      "surah_number": 88,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ",
      "english_translation": "HAS THERE COME unto thee the tiding of the Overshadowing Event?'"
    },
    {
      "ayah_reference": "88:2",
      "surah_number": 88,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ",
      "english_translation": "Some faces will on that Day be downcast,"
    },
    {
      "ayah_reference": "88:3",
      "surah_number": 88,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "عَامِلَةٌۭ نَّاصِبَةٌۭ",
      "english_translation": "toiling [under burdens of sin], worn out [by fear],"
    },
    {
      "ayah_reference": "88:4",
      "surah_number": 88,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "تَصْلَىٰ نَارًا حَامِيَةًۭ",
      "english_translation": "about to enter a glowing fire,"
    },
    {
      "ayah_reference": "88:5",
      "surah_number": 88,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ",
      "english_translation": "given to drink from a boiling spring."
    },
    {
      "ayah_reference": "88:6",
      "surah_number": 88,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ",
      "english_translation": "No food for them save the bitterness of dry thorns,"
    },
    {
      "ayah_reference": "88:7",
      "surah_number": 88,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ",
      "english_translation": "which gives no strength and neither stills hunger."
    },
    {
      "ayah_reference": "88:8",
      "surah_number": 88,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ",
      "english_translation": "[And] some faces will on that Day shine with bliss,"
    },
    {
      "ayah_reference": "88:9",
      "surah_number": 88,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "لِّسَعْيِهَا رَاضِيَةٌۭ",
      "english_translation": "well-pleased with [the fruit of] their striving,"
    },
    {
      "ayah_reference": "88:10",
      "surah_number": 88,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "فِى جَنَّةٍ عَالِيَةٍۢ",
      "english_translation": "in a garden sublime,"
    },
    {
      "ayah_reference": "88:11",
      "surah_number": 88,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ",
      "english_translation": "wherein thou wilt hear no empty talk."
    },
    {
      "ayah_reference": "88:12",
      "surah_number": 88,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ",
      "english_translation": "Countless springs will flow therein,"
    },
    {
      "ayah_reference": "88:13",
      "surah_number": 88,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ",
      "english_translation": "[and] there will be thrones [of happiness] raised high,"
    },
    {
      "ayah_reference": "88:14",
      "surah_number": 88,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ",
      "english_translation": "and goblets placed ready,"
    },
    {
      "ayah_reference": "88:15",
      "surah_number": 88,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "وَنَمَارِقُ مَصْفُوفَةٌۭ",
      "english_translation": "and cushions ranged,"
    },
    {
      "ayah_reference": "88:16",
      "surah_number": 88,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "english_translation": "and carpets spread out…"
    },
    {
      "ayah_reference": "88:17",
      "surah_number": 88,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "english_translation": "DO, THEN, they [who deny resurrection] never gaze at the clouds pregnant with water, [and observe] how they are created?"
    },
    {
      "ayah_reference": "88:18",
      "surah_number": 88,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "english_translation": "And at the sky, how it is raised aloft?"
    },
    {
      "ayah_reference": "88:19",
      "surah_number": 88,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "english_translation": "And at the mountains, how firmly they are reared?"
    },
    {
      "ayah_reference": "88:20",
      "surah_number": 88,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "english_translation": "And at the earth, how it is spread out?"
    },
    {
      "ayah_reference": "88:21",
      "surah_number": 88,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ",
      "english_translation": "And so, [O Prophet,] exhort them; thy task is only to exhort:"
    },
    {
      "ayah_reference": "88:22",
      "surah_number": 88,
      "ayah_number": 22,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "english_translation": "thou canst not compel them [to believe]."
    },
    {
      "ayah_reference": "88:23",
      "surah_number": 88,
      "ayah_number": 23,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "english_translation": "However, as for him who turns away, being bent on denying the truth,"
    },
    {
      "ayah_reference": "88:24",
      "surah_number": 88,
      "ayah_number": 24,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "english_translation": "him will God cause to suffer the greatest suffering [in the life to come]:"
    },
    {
      "ayah_reference": "88:25",
      "surah_number": 88,
      "ayah_number": 25,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "english_translation": "for behold, unto Us will be their return,"
    },
    {
      "ayah_reference": "88:26",
      "surah_number": 88,
      "ayah_number": 26,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "sajda": false,
      "arabic_text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "english_translation": "and verily, It is for Us to call them to account."
    }
  ]
}