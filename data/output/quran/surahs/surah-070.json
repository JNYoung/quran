{
  "surah_number": 70,
  "surah_name_arabic": "سُورَةُ المَعَارِجِ",
  "surah_name_english": "Al-Ma'aarij",
  "surah_name_english_translation": "The Ascending Stairways",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "70:1",
      "surah_number": 70,
      "ayah_number": 1,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ",
      "english_translation": "ONE who is minded to ask might ask about the suffering which [in the hereafter] is bound to befall"
    },
    {
      "ayah_reference": "70:2",
      "surah_number": 70,
      "ayah_number": 2,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ",
      "english_translation": "those who deny the truth. [Know, then, that] nothing can ward it off,"
    },
    {
      "ayah_reference": "70:3",
      "surah_number": 70,
      "ayah_number": 3,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ",
      "english_translation": "[since it will come] from God, unto whom there are many ways of ascent:"
    },
    {
      "ayah_reference": "70:4",
      "surah_number": 70,
      "ayah_number": 4,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ",
      "english_translation": "all the angels and all the inspiration [ever granted to man] ascend unto Him [daily,] in a day the length whereof is [like] fifty thousand years…"
    },
    {
      "ayah_reference": "70:5",
      "surah_number": 70,
      "ayah_number": 5,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "فَٱصْبِرْ صَبْرًۭا جَمِيلًا",
      "english_translation": "Therefore, [O believer,] endure all adversity with goodly patience:"
    },
    {
      "ayah_reference": "70:6",
      "surah_number": 70,
      "ayah_number": 6,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا",
      "english_translation": "behold, men look upon that [reckoning] as something far away –"
    },
    {
      "ayah_reference": "70:7",
      "surah_number": 70,
      "ayah_number": 7,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَنَرَىٰهُ قَرِيبًۭا",
      "english_translation": "but, We see it as near!"
    },
    {
      "ayah_reference": "70:8",
      "surah_number": 70,
      "ayah_number": 8,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ",
      "english_translation": "[It will take place] on a Day when the sky will be like molten lead,"
    },
    {
      "ayah_reference": "70:9",
      "surah_number": 70,
      "ayah_number": 9,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
      "english_translation": "and the mountains will be like tufts of wool,"
    },
    {
      "ayah_reference": "70:10",
      "surah_number": 70,
      "ayah_number": 10,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا",
      "english_translation": "and [when] no friend will ask about his friend,"
    },
    {
      "ayah_reference": "70:11",
      "surah_number": 70,
      "ayah_number": 11,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ",
      "english_translation": "though they may be in one another's sight: [for,] everyone who was lost in sin will on that Day but desire to ransom himself from suffering at the price of his own children,"
    },
    {
      "ayah_reference": "70:12",
      "surah_number": 70,
      "ayah_number": 12,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَصَٰحِبَتِهِۦ وَأَخِيهِ",
      "english_translation": "and of his spouse, and of his brother,"
    },
    {
      "ayah_reference": "70:13",
      "surah_number": 70,
      "ayah_number": 13,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ",
      "english_translation": "and of all the kinsfolk who ever sheltered him,"
    },
    {
      "ayah_reference": "70:14",
      "surah_number": 70,
      "ayah_number": 14,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ",
      "english_translation": "and of whoever [else] lives on earth, all of them - so that he could but save himself."
    },
    {
      "ayah_reference": "70:15",
      "surah_number": 70,
      "ayah_number": 15,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "كَلَّآ ۖ إِنَّهَا لَظَىٰ",
      "english_translation": "But nay! Verily, all [that awaits him] is a raging flame,"
    },
    {
      "ayah_reference": "70:16",
      "surah_number": 70,
      "ayah_number": 16,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "نَزَّاعَةًۭ لِّلشَّوَىٰ",
      "english_translation": "tearing away his skin!"
    },
    {
      "ayah_reference": "70:17",
      "surah_number": 70,
      "ayah_number": 17,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ",
      "english_translation": "It will claim all such as turn their backs [on what is right], and turn away [from the truth],"
    },
    {
      "ayah_reference": "70:18",
      "surah_number": 70,
      "ayah_number": 18,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَجَمَعَ فَأَوْعَىٰٓ",
      "english_translation": "and amass [wealth] and thereupon withhold [it from their fellow-men]."
    },
    {
      "ayah_reference": "70:19",
      "surah_number": 70,
      "ayah_number": 19,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا",
      "english_translation": "VERILY, man is born with a restless disposition."
    },
    {
      "ayah_reference": "70:20",
      "surah_number": 70,
      "ayah_number": 20,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا",
      "english_translation": "[As a rule,] whenever misfortune touches him, he is filled with self-pity;"
    },
    {
      "ayah_reference": "70:21",
      "surah_number": 70,
      "ayah_number": 21,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا",
      "english_translation": "and whenever good fortune comes to him, he selfishly withholds it [from others]."
    },
    {
      "ayah_reference": "70:22",
      "surah_number": 70,
      "ayah_number": 22,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "إِلَّا ٱلْمُصَلِّينَ",
      "english_translation": "Not so, however, those who consciously turn towards God in prayer."
    },
    {
      "ayah_reference": "70:23",
      "surah_number": 70,
      "ayah_number": 23,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ",
      "english_translation": "[and] who incessantly persevere in their prayer"
    },
    {
      "ayah_reference": "70:24",
      "surah_number": 70,
      "ayah_number": 24,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ",
      "english_translation": "and in whose possessions there is a due share, acknowledged [by them],"
    },
    {
      "ayah_reference": "70:25",
      "surah_number": 70,
      "ayah_number": 25,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
      "english_translation": "for such as ask [for help] and such as are deprived [of what is good in life];"
    },
    {
      "ayah_reference": "70:26",
      "surah_number": 70,
      "ayah_number": 26,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ",
      "english_translation": "and who accept as true the [coming of the] Day of Judgment;"
    },
    {
      "ayah_reference": "70:27",
      "surah_number": 70,
      "ayah_number": 27,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ",
      "english_translation": "and who stand in dread of their Sustainer's chastisement –"
    },
    {
      "ayah_reference": "70:28",
      "surah_number": 70,
      "ayah_number": 28,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ",
      "english_translation": "for, behold, of their Sustainer's chastisement none may ever feel [wholly] secure;"
    },
    {
      "ayah_reference": "70:29",
      "surah_number": 70,
      "ayah_number": 29,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ",
      "english_translation": "and who are mindful of their chastity,"
    },
    {
      "ayah_reference": "70:30",
      "surah_number": 70,
      "ayah_number": 30,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ",
      "english_translation": "[not giving way to their desires] with any but their spouses - that is, those whom they rightfully possess [through wedlock] -: for then, behold, they are free of all blame,"
    },
    {
      "ayah_reference": "70:31",
      "surah_number": 70,
      "ayah_number": 31,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ",
      "english_translation": "whereas such as seek to go beyond that [limit] are truly transgressors;"
    },
    {
      "ayah_reference": "70:32",
      "surah_number": 70,
      "ayah_number": 32,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
      "english_translation": "and who are faithful to their trusts and to their pledges:"
    },
    {
      "ayah_reference": "70:33",
      "surah_number": 70,
      "ayah_number": 33,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ",
      "english_translation": "and who stand firm whenever they bear witness;"
    },
    {
      "ayah_reference": "70:34",
      "surah_number": 70,
      "ayah_number": 34,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ",
      "english_translation": "and who guard their prayers [from all worldly intent]."
    },
    {
      "ayah_reference": "70:35",
      "surah_number": 70,
      "ayah_number": 35,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "sajda": false,
      "arabic_text": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ",
      "english_translation": "These it is who in the gardens [of paradise] shall be honoured!"
    },
    {
      "ayah_reference": "70:36",
      "surah_number": 70,
      "ayah_number": 36,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 503,
      "sajda": false,
      "arabic_text": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ",
      "english_translation": "WHAT, THEN, is amiss with such as are bent on denying the truth, that they run about confusedly to and fro before thee,"
    },
    {
      "ayah_reference": "70:37",
      "surah_number": 70,
      "ayah_number": 37,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 503,
      "sajda": false,
      "arabic_text": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
      "english_translation": "[coming upon thee] from the right and from the left, in crowds?"
    },
    {
      "ayah_reference": "70:38",
      "surah_number": 70,
      "ayah_number": 38,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 503,
      "sajda": false,
      "arabic_text": "أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ",
      "english_translation": "Does every one of them hope to enter [by this means] a garden of bliss?"
    },
    {
      "ayah_reference": "70:39",
      "surah_number": 70,
      "ayah_number": 39,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 569,
      "ruku": 503,
      "sajda": false,
      "arabic_text": "كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ",
      "english_translation": "Never! For, behold, We have created them out of something that they know [only too well]!"
    },
    {
      "ayah_reference": "70:40",
      "surah_number": 70,
      "ayah_number": 40,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 570,
      "ruku": 503,
      "sajda": false,
      "arabic_text": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ",
      "english_translation": "But nay! I call to witness [Our being] the Sustainer of all the points of sunrise and sunset: verily, well able are We"
    },
    {
      "ayah_reference": "70:41",
      "surah_number": 70,
      "ayah_number": 41,
      "juz": 29,
      "hizb_quarter": 228,
      "manzil": 7,
      "page": 570,
      "ruku": 503,
      "sajda": false,
      "arabic_text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًۭا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "english_translation": "to replace them with [people] better than they are; for there is nothing to prevent Us [from doing what We will]."
    },
    {
      "ayah_reference": "70:42",
      "surah_number": 70,
      "ayah_number": 42,
