{
  "surah_number": 82,
  "surah_name_arabic": "سُورَةُ الانفِطَارِ",
  "surah_name_english": "Al-Infitaar",
  "surah_name_english_translation": "The Cleaving",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "82:1",
      "surah_number": 82,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
      "english_translation": "WHEN THE SKY is cleft asunder,"
    },
    {
      "ayah_reference": "82:2",
      "surah_number": 82,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
      "english_translation": "and when the stars are scattered,"
    },
    {
      "ayah_reference": "82:3",
      "surah_number": 82,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
      "english_translation": "and when the seas burst beyond their bounds,"
    },
    {
      "ayah_reference": "82:4",
      "surah_number": 82,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
      "english_translation": "and when the graves are overturned –"
    },
    {
      "ayah_reference": "82:5",
      "surah_number": 82,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ",
      "english_translation": "every human being will [at last] comprehend, what he has sent ahead and what he has held back [in this world]."
    },
    {
      "ayah_reference": "82:6",
      "surah_number": 82,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
      "english_translation": "O MAN! What is it that lures thee away from thy bountiful Sustainer,"
    },
    {
      "ayah_reference": "82:7",
      "surah_number": 82,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
      "english_translation": "who has created thee, and formed thee in accordance with what thou art meant' to be, and shaped thy nature in just proportions,"
    },
    {
      "ayah_reference": "82:8",
      "surah_number": 82,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ",
      "english_translation": "having put thee together in whatever form He willed [thee to have]?"
    },
    {
      "ayah_reference": "82:9",
      "surah_number": 82,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
      "english_translation": "Nay, [O men,] but you [are lured away from God whenever you are tempted to] give the lie to [God’s] Judgment!"
    },
    {
      "ayah_reference": "82:10",
      "surah_number": 82,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ",
      "english_translation": "And yet, verily, there are ever-watchful forces over you,"
    },
    {
      "ayah_reference": "82:11",
      "surah_number": 82,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "كِرَامًۭا كَٰتِبِينَ",
      "english_translation": "noble, recording,"
    },
    {
      "ayah_reference": "82:12",
      "surah_number": 82,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "يَعْلَمُونَ مَا تَفْعَلُونَ",
      "english_translation": "aware of whatever you do!"
    },
    {
      "ayah_reference": "82:13",
      "surah_number": 82,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ",
      "english_translation": "Behold, [in the life to come] the truly virtuous: will indeed be in bliss,"
    },
    {
      "ayah_reference": "82:14",
      "surah_number": 82,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ",
      "english_translation": "whereas, behold, the wicked will indeed be in a blazing fire –"
    },
    {
      "ayah_reference": "82:15",
      "surah_number": 82,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
      "english_translation": "[a fire] which they shall enter on Judgment Day,"
    },
    {
      "ayah_reference": "82:16",
      "surah_number": 82,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
      "english_translation": "and which they shall not [be able to] evade."
    },
    {
      "ayah_reference": "82:17",
      "surah_number": 82,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "english_translation": "And what could make thee conceive what that Judgment Day will be?"
    },
    {
      "ayah_reference": "82:18",
      "surah_number": 82,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "english_translation": "And once again: What could make thee conceive what that Judgment Day will be?"
    },
    {
      "ayah_reference": "82:19",
      "surah_number": 82,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 235,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "sajda": false,
      "arabic_text": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ",
      "english_translation": "[It will be] a Day when no human being shall be of the least avail to another human being: for on that Day [it will become manifest that] all sovereignty is God's alone."
    }
  ]
}