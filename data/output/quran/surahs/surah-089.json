{
  "surah_number": 89,
  "surah_name_arabic": "سُورَةُ الفَجۡرِ",
  "surah_name_english": "Al-Fajr",
  "surah_name_english_translation": "The Dawn",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "89:1",
      "surah_number": 89,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ",
      "english_translation": "CONSIDER the daybreak"
    },
    {
      "ayah_reference": "89:2",
      "surah_number": 89,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَلَيَالٍ عَشْرٍۢ",
      "english_translation": "and the ten nights!"
    },
    {
      "ayah_reference": "89:3",
      "surah_number": 89,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
      "english_translation": "Consider the multiple and the One!"
    },
    {
      "ayah_reference": "89:4",
      "surah_number": 89,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَٱلَّيْلِ إِذَا يَسْرِ",
      "english_translation": "Consider the night as it runs its course!"
    },
    {
      "ayah_reference": "89:5",
      "surah_number": 89,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ",
      "english_translation": "Considering all this - could there be, to anyone endowed with reason, a [more] solemn evidence of the truth?"
    },
    {
      "ayah_reference": "89:6",
      "surah_number": 89,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
      "english_translation": "ART THOU NOT aware of how thy Sustainer has dealt with [the tribe of] ‘Ad,"
    },
    {
      "ayah_reference": "89:7",
      "surah_number": 89,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
      "english_translation": "[the people of] Iram the many-pillared,"
    },
    {
      "ayah_reference": "89:8",
      "surah_number": 89,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ",
      "english_translation": "the like of whom has never been reared in all the land? –"
    },
    {
      "ayah_reference": "89:9",
      "surah_number": 89,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
      "english_translation": "and with [the tribe of] Thamud, who hollowed out rocks in the valley? –"
    },
    {
      "ayah_reference": "89:10",
      "surah_number": 89,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
      "english_translation": "and with Pharaoh of the [many] tent-poles?"
    },
    {
      "ayah_reference": "89:11",
      "surah_number": 89,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ",
      "english_translation": "[It was they] who transgressed all bounds of equity all over their lands,"
    },
    {
      "ayah_reference": "89:12",
      "surah_number": 89,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
      "english_translation": "and brought about great corruption therein:"
    },
    {
      "ayah_reference": "89:13",
      "surah_number": 89,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
      "english_translation": "and therefore thy Sustainer let loose upon them a scourge of suffering:"
    },
    {
      "ayah_reference": "89:14",
      "surah_number": 89,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
      "english_translation": "for, verily, thy Sustainer is ever on the watch!"
    },
    {
      "ayah_reference": "89:15",
      "surah_number": 89,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
      "english_translation": "BUT AS FOR man, whenever his Sustainer tries him by His generosity and by letting him enjoy a life of ease, he says, \"My Sustainer has been [justly] generous towards me\";"
    },
    {
      "ayah_reference": "89:16",
      "surah_number": 89,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ",
      "english_translation": "whereas, whenever He tries him by straitening his means of livelihood, he says, \"My Sustainer has disgraced me!\""
    },
    {
      "ayah_reference": "89:17",
      "surah_number": 89,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
      "english_translation": "But nay, nay, [O men, consider all that you do and fail to do:] you are not generous towards the orphan,"
    },
    {
      "ayah_reference": "89:18",
      "surah_number": 89,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "english_translation": "and you do not urge one another to feed the needy,"
    },
    {
      "ayah_reference": "89:19",
      "surah_number": 89,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا",
      "english_translation": "and you devour the inheritance [of others] with devouring greed,"
    },
    {
      "ayah_reference": "89:20",
      "surah_number": 89,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا",
      "english_translation": "and you love wealth with boundless love!"
    },
    {
      "ayah_reference": "89:21",
      "surah_number": 89,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا",
      "english_translation": "Nay, but [how will you fare on Judgment Day,] when the earth is crushed with crushing upon crushing,"
    },
    {
      "ayah_reference": "89:22",
      "surah_number": 89,
      "ayah_number": 22,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا",
      "english_translation": "and [the majesty of] thy Sustainer stands revealed, as well as [the true nature of] the angels; rank upon rank?"
    },
    {
      "ayah_reference": "89:23",
      "surah_number": 89,
      "ayah_number": 23,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
      "english_translation": "And on that Day hell will be brought [within sight]; on that Day man will remember [all that he did and failed to do]: but what will that remembrance avail him?"
    },
    {
      "ayah_reference": "89:24",
      "surah_number": 89,
      "ayah_number": 24,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
      "english_translation": "He will say, \"Oh, would that I had. provided beforehand for my life [to come]!\""
    },
    {
      "ayah_reference": "89:25",
      "surah_number": 89,
      "ayah_number": 25,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ",
      "english_translation": "For, none can make suffer as He will make suffer [the sinners] on that Day,"
    },
    {
      "ayah_reference": "89:26",
      "surah_number": 89,
      "ayah_number": 26,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ",
      "english_translation": "and none can bind with bonds like His."
    },
    {
      "ayah_reference": "89:27",
      "surah_number": 89,
      "ayah_number": 27,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
      "english_translation": "[But unto the righteous God will say,] \"O thou human being that hast attained to inner peace!"
    },
    {
      "ayah_reference": "89:28",
      "surah_number": 89,
      "ayah_number": 28,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ",
      "english_translation": "Return thou unto thy Sustainer, well-pleased [and] pleasing [Him]:"
    },
    {
      "ayah_reference": "89:29",
      "surah_number": 89,
      "ayah_number": 29,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "فَٱدْخُلِى فِى عِبَٰدِى",
      "english_translation": "enter, then, together with My [other true] servants –"
    },
    {
      "ayah_reference": "89:30",
      "surah_number": 89,
      "ayah_number": 30,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 594,
      "ruku": 531,
      "sajda": false,
      "arabic_text": "وَٱدْخُلِى جَنَّتِى",
      "english_translation": "yea, enter thou My paradise!\""
    }
  ]
}