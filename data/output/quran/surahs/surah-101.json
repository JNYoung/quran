{
  "surah_number": 101,
  "surah_name_arabic": "سُورَةُ القَارِعَةِ",
  "surah_name_english": "Al-Qaari'a",
  "surah_name_english_translation": "The Calamity",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "101:1",
      "surah_number": 101,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ",
      "english_translation": "OH, the sudden calamity!"
    },
    {
      "ayah_reference": "101:2",
      "surah_number": 101,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "مَا ٱلْقَارِعَةُ",
      "english_translation": "How awesome the sudden calamity!"
    },
    {
      "ayah_reference": "101:3",
      "surah_number": 101,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
      "english_translation": "And what could make thee conceive what that sudden calamity will be?"
    },
    {
      "ayah_reference": "101:4",
      "surah_number": 101,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
      "english_translation": "[It will occur] on the Day when men will be like moths swarming in confusion,"
    },
    {
      "ayah_reference": "101:5",
      "surah_number": 101,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
      "english_translation": "and the mountains will be like fluffy tufts of wool...."
    },
    {
      "ayah_reference": "101:6",
      "surah_number": 101,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",
      "english_translation": "And then, he whose weight [of good deeds] is heavy in the balance"
    },
    {
      "ayah_reference": "101:7",
      "surah_number": 101,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ",
      "english_translation": "shall find himself in a happy' state of life;"
    },
    {
      "ayah_reference": "101:8",
      "surah_number": 101,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
      "english_translation": "whereas he whose weight is light in the balance"
    },
    {
      "ayah_reference": "101:9",
      "surah_number": 101,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "فَأُمُّهُۥ هَاوِيَةٌۭ",
      "english_translation": "shall be engulfed by an abyss."
    },
    {
      "ayah_reference": "101:10",
      "surah_number": 101,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ",
      "english_translation": "And what could make thee conceive what that [abyss] will be?"
    },
    {
      "ayah_reference": "101:11",
      "surah_number": 101,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "sajda": false,
      "arabic_text": "نَارٌ حَامِيَةٌۢ",
      "english_translation": "A fire hotly burning!"
    }
  ]
}