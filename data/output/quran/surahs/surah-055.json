{
  "surah_number": 55,
  "surah_name_arabic": "سُورَةُ الرَّحۡمَٰن",
  "surah_name_english": "Ar-Rahmaan",
  "surah_name_english_translation": "The Beneficent",
  "revelation_type": "Medinan",
  "ayahs": [
    {
      "ayah_reference": "55:1",
      "surah_number": 55,
      "ayah_number": 1,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ",
      "english_translation": "THE MOST GRACIOUS"
    },
    {
      "ayah_reference": "55:2",
      "surah_number": 55,
      "ayah_number": 2,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "عَلَّمَ ٱلْقُرْءَانَ",
      "english_translation": "has imparted this Qur’an [unto man]."
    },
    {
      "ayah_reference": "55:3",
      "surah_number": 55,
      "ayah_number": 3,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "خَلَقَ ٱلْإِنسَٰنَ",
      "english_translation": "He has created man:"
    },
    {
      "ayah_reference": "55:4",
      "surah_number": 55,
      "ayah_number": 4,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "عَلَّمَهُ ٱلْبَيَانَ",
      "english_translation": "He has imparted unto him articulate thought and speech."
    },
    {
      "ayah_reference": "55:5",
      "surah_number": 55,
      "ayah_number": 5,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ",
      "english_translation": "[At His behest] the sun and the moon run their appointed courses;"
    },
    {
      "ayah_reference": "55:6",
      "surah_number": 55,
      "ayah_number": 6,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "english_translation": "[before Him] prostrate them­selves the stars and the trees."
    },
    {
      "ayah_reference": "55:7",
      "surah_number": 55,
      "ayah_number": 7,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
      "english_translation": "And the skies has He raised high, and has devised [for all things] a measure,"
    },
    {
      "ayah_reference": "55:8",
      "surah_number": 55,
      "ayah_number": 8,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "english_translation": "so that you [too, O men,] might never transgress the measure [of what is right]:"
    },
    {
      "ayah_reference": "55:9",
      "surah_number": 55,
      "ayah_number": 9,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "english_translation": "weigh, therefore, [your deeds] with equity, and cut not the measure short!"
    },
    {
      "ayah_reference": "55:10",
      "surah_number": 55,
      "ayah_number": 10,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ",
      "english_translation": "And the earth has He spread out for all living beings,"
    },
    {
      "ayah_reference": "55:11",
      "surah_number": 55,
      "ayah_number": 11,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",
      "english_translation": "with fruit thereon, and palm trees with sheathed clusters [of dates],"
    },
    {
      "ayah_reference": "55:12",
      "surah_number": 55,
      "ayah_number": 12,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",
      "english_translation": "and grain growing tall on its stalks, and sweet-smelling plants."
    },
    {
      "ayah_reference": "55:13",
      "surah_number": 55,
      "ayah_number": 13,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:14",
      "surah_number": 55,
      "ayah_number": 14,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ",
      "english_translation": "He has created man out of sounding clay, like pottery,"
    },
    {
      "ayah_reference": "55:15",
      "surah_number": 55,
      "ayah_number": 15,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ",
      "english_translation": "whereas the invisible beings He has created out of a confusing flame of fire."
    },
    {
      "ayah_reference": "55:16",
      "surah_number": 55,
      "ayah_number": 16,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:17",
      "surah_number": 55,
      "ayah_number": 17,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ",
      "english_translation": "[He is] the Sustainer of the two farthest points of sunrise, and the Sustainer of the two farthest points of sunset."
    },
    {
      "ayah_reference": "55:18",
      "surah_number": 55,
      "ayah_number": 18,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustain­er’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:19",
      "surah_number": 55,
      "ayah_number": 19,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",
      "english_translation": "He has given freedom to the two great bodies of water, so that they might meet:"
    },
    {
      "ayah_reference": "55:20",
      "surah_number": 55,
      "ayah_number": 20,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ",
      "english_translation": "[yet] between them is a barrier which they may not transgress."
    },
    {
      "ayah_reference": "55:21",
      "surah_number": 55,
      "ayah_number": 21,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:22",
      "surah_number": 55,
      "ayah_number": 22,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",
      "english_translation": "Out of these two [bodies of water] come forth pearls, both great and small."
    },
    {
      "ayah_reference": "55:23",
      "surah_number": 55,
      "ayah_number": 23,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:24",
      "surah_number": 55,
      "ayah_number": 24,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ",
      "english_translation": "And His are the lofty ships that sail like [floating] mountains through the seas."
    },
    {
      "ayah_reference": "55:25",
      "surah_number": 55,
      "ayah_number": 25,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 466,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:26",
      "surah_number": 55,
      "ayah_number": 26,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "كُلُّ مَنْ عَلَيْهَا فَانٍۢ",
      "english_translation": "All that lives on earth or in the heavens is bound to pass away:"
    },
    {
      "ayah_reference": "55:27",
      "surah_number": 55,
      "ayah_number": 27,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ",
      "english_translation": "but forever will abide thy Sustainer’s Self, full of majesty and glory."
    },
    {
      "ayah_reference": "55:28",
      "surah_number": 55,
      "ayah_number": 28,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:29",
      "surah_number": 55,
      "ayah_number": 29,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ",
      "english_translation": "On Him depends all creatures in the heavens and on earth; [and] every day He manifests Himself in yet another [wondrous] way."
    },
    {
      "ayah_reference": "55:30",
      "surah_number": 55,
      "ayah_number": 30,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:31",
      "surah_number": 55,
      "ayah_number": 31,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ",
      "english_translation": "[ONE DAY] We shall take you to task, O you sin-laden two!"
    },
    {
      "ayah_reference": "55:32",
      "surah_number": 55,
      "ayah_number": 32,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:33",
      "surah_number": 55,
      "ayah_number": 33,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍۢ",
      "english_translation": "O you who live in close communion with [evil] invisible beings and humans! If you [think that you] can pass beyond the regions of the heavens and the earth, pass beyond them! [But] you cannot pass beyond them, save by a sanction [from God]!"
    },
    {
      "ayah_reference": "55:34",
      "surah_number": 55,
      "ayah_number": 34,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:35",
      "surah_number": 55,
      "ayah_number": 35,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌۭ مِّن نَّارٍۢ وَنُحَاسٌۭ فَلَا تَنتَصِرَانِ",
      "english_translation": "A flash of fire will be let loose upon you, and smoke, and you will be left without succour!"
    },
    {
      "ayah_reference": "55:36",
      "surah_number": 55,
      "ayah_number": 36,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:37",
      "surah_number": 55,
      "ayah_number": 37,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةًۭ كَٱلدِّهَانِ",
      "english_translation": "And when the sky is rent asunder and becomes red like [burning] oil"
    },
    {
      "ayah_reference": "55:38",
      "surah_number": 55,
      "ayah_number": 38,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:39",
      "surah_number": 55,
      "ayah_number": 39,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَيَوْمَئِذٍۢ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌۭ وَلَا جَآنٌّۭ",
      "english_translation": "For on that Day neither man nor invisible being will be asked about his sins."
    },
    {
      "ayah_reference": "55:40",
      "surah_number": 55,
      "ayah_number": 40,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 532,
      "ruku": 467,
      "sajda": false,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "english_translation": "Which, then, of your Sustainer’s powers can you disavow?"
    },
    {
      "ayah_reference": "55:41",
      "surah_number": 55,
      "ayah_number": 41,
      "juz": 27,
      "hizb_quarter": 213,
      "manzil": 7,
      "page": 533,
      "ruku": 467,
      "sajda": false,
