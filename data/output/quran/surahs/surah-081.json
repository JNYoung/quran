{
  "surah_number": 81,
  "surah_name_arabic": "سُورَةُ التَّكۡوِيرِ",
  "surah_name_english": "At-Takwir",
  "surah_name_english_translation": "The Overthrowing",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "81:1",
      "surah_number": 81,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "english_translation": "WHEN THE SUN is shrouded in darkness,"
    },
    {
      "ayah_reference": "81:2",
      "surah_number": 81,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "english_translation": "and when the stars lose their light,"
    },
    {
      "ayah_reference": "81:3",
      "surah_number": 81,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "english_translation": "and when the mountains are made to vanish,"
    },
    {
      "ayah_reference": "81:4",
      "surah_number": 81,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "english_translation": "and when she-camels big with young, about to give birth, are left untended,"
    },
    {
      "ayah_reference": "81:5",
      "surah_number": 81,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "english_translation": "and when all beasts are gathered together,"
    },
    {
      "ayah_reference": "81:6",
      "surah_number": 81,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "english_translation": "and when the seas boil over,"
    },
    {
      "ayah_reference": "81:7",
      "surah_number": 81,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "english_translation": "and when all human beings are coupled [with their deeds],"
    },
    {
      "ayah_reference": "81:8",
      "surah_number": 81,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "english_translation": "and when the girl-child that was buried alive is made to ask"
    },
    {
      "ayah_reference": "81:9",
      "surah_number": 81,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ",
      "english_translation": "for what crime she had been slain,"
    },
    {
      "ayah_reference": "81:10",
      "surah_number": 81,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "english_translation": "and when the scrolls [of men's deeds] are unfolded,"
    },
    {
      "ayah_reference": "81:11",
      "surah_number": 81,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "english_translation": "and when heaven is laid bare,"
    },
    {
      "ayah_reference": "81:12",
      "surah_number": 81,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "english_translation": "and when the blazing fire [of hell] is kindled bright,"
    },
    {
      "ayah_reference": "81:13",
      "surah_number": 81,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "english_translation": "and when paradise is brought into view:"
    },
    {
      "ayah_reference": "81:14",
      "surah_number": 81,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ",
      "english_translation": "[on that Day] every human being will come to know what he has prepared [for himself]."
    },
    {
      "ayah_reference": "81:15",
      "surah_number": 81,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "english_translation": "BUT NAY! I call to witness the revolving stars,"
    },
    {
      "ayah_reference": "81:16",
      "surah_number": 81,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "english_translation": "the planets that run their course and set,"
    },
    {
      "ayah_reference": "81:17",
      "surah_number": 81,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "english_translation": "and the night as it darkly falls,"
    },
    {
      "ayah_reference": "81:18",
      "surah_number": 81,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "english_translation": "and the morn as it softly breathes:"
    },
    {
      "ayah_reference": "81:19",
      "surah_number": 81,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ",
      "english_translation": "behold, this [divine writ] is indeed the [inspired] word of a noble apostle,"
    },
    {
      "ayah_reference": "81:20",
      "surah_number": 81,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ",
      "english_translation": "with strength endowed, secure with Him who in almightiness is enthroned"
    },
    {
      "ayah_reference": "81:21",
      "surah_number": 81,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ",
      "english_translation": "[the word] of one to be heeded, and worthy of trust!"
    },
    {
      "ayah_reference": "81:22",
      "surah_number": 81,
      "ayah_number": 22,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ",
      "english_translation": "For, this fellow-man of yours is not a madman:"
    },
    {
      "ayah_reference": "81:23",
      "surah_number": 81,
      "ayah_number": 23,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "english_translation": "he truly beheld [the angel - beheld] him on the clear horizon;"
    },
    {
      "ayah_reference": "81:24",
      "surah_number": 81,
      "ayah_number": 24,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ",
      "english_translation": "and he is not one to begrudge others the knowledge [of whatever has been revealed to him] out of that which is beyond the reach of human Perception."
    },
    {
      "ayah_reference": "81:25",
      "surah_number": 81,
      "ayah_number": 25,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ",
      "english_translation": "Nor is this [message] the word of any satanic force accursed."
    },
    {
      "ayah_reference": "81:26",
      "surah_number": 81,
      "ayah_number": 26,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "فَأَيْنَ تَذْهَبُونَ",
      "english_translation": "Whither, then, will you go?"
    },
    {
      "ayah_reference": "81:27",
      "surah_number": 81,
      "ayah_number": 27,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ",
      "english_translation": "This [message] is no less than a reminder to all mankind –"
    },
    {
      "ayah_reference": "81:28",
      "surah_number": 81,
      "ayah_number": 28,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "english_translation": "to everyone of you who wills to walk a straight way."
    },
    {
      "ayah_reference": "81:29",
      "surah_number": 81,
      "ayah_number": 29,
      "juz": 30,
      "hizb_quarter": 234,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "sajda": false,
      "arabic_text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ",
      "english_translation": "But you cannot will it unless God, the Sustainer of all the worlds, wills [to show you that way]."
    }
  ]
}