{
  "surah_number": 93,
  "surah_name_arabic": "سُورَةُ الضُّحَىٰ",
  "surah_name_english": "Ad-Dhuhaa",
  "surah_name_english_translation": "The Morning Hours",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "93:1",
      "surah_number": 93,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ",
      "english_translation": "CONSIDER the bright morning hours,"
    },
    {
      "ayah_reference": "93:2",
      "surah_number": 93,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "وَٱلَّيْلِ إِذَا سَجَىٰ",
      "english_translation": "and the night when it grows still and dark."
    },
    {
      "ayah_reference": "93:3",
      "surah_number": 93,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "english_translation": "Thy Sustainer has not forsaken thee, nor does He scorn thee:"
    },
    {
      "ayah_reference": "93:4",
      "surah_number": 93,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ",
      "english_translation": "for, indeed, the life to come will be better for thee than this earlier part [of thy life]!"
    },
    {
      "ayah_reference": "93:5",
      "surah_number": 93,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
      "english_translation": "And, indeed, in time will thy Sustainer grant thee [what thy heart desires], and thou shalt be well-pleased."
    },
    {
      "ayah_reference": "93:6",
      "surah_number": 93,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ",
      "english_translation": "Has He not found thee an orphan, and given thee shelter?"
    },
    {
      "ayah_reference": "93:7",
      "surah_number": 93,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ",
      "english_translation": "And found thee lost on thy way, and guided thee?"
    },
    {
      "ayah_reference": "93:8",
      "surah_number": 93,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ",
      "english_translation": "And found thee in want, and given thee sufficiency?"
    },
    {
      "ayah_reference": "93:9",
      "surah_number": 93,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
      "english_translation": "Therefore, the orphan shalt thou never wrong,"
    },
    {
      "ayah_reference": "93:10",
      "surah_number": 93,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
      "english_translation": "and him that seeks [thy] help shalt thou never chide,"
    },
    {
      "ayah_reference": "93:11",
      "surah_number": 93,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "sajda": false,
      "arabic_text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
      "english_translation": "and of thy Sustainer's blessings shalt thou [ever] speak."
    }
  ]
}