{
  "surah_number": 111,
  "surah_name_arabic": "سُورَةُ المَسَدِ",
  "surah_name_english": "Al-Masad",
  "surah_name_english_translation": "The Palm Fibre",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "111:1",
