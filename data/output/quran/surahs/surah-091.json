{
  "surah_number": 91,
  "surah_name_arabic": "سُورَةُ الشَّمۡسِ",
  "surah_name_english": "Ash-Shams",
  "surah_name_english_translation": "The Sun",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "91:1",
      "surah_number": 91,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا",
      "english_translation": "CONSIDER the sun and its radiant brightness,"
    },
    {
      "ayah_reference": "91:2",
      "surah_number": 91,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "english_translation": "and the moon as it reflects the sun!"
    },
    {
      "ayah_reference": "91:3",
      "surah_number": 91,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "english_translation": "Consider the day as it reveals the world,"
    },
    {
      "ayah_reference": "91:4",
      "surah_number": 91,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "english_translation": "and the night as it veils it darkly!"
    },
    {
      "ayah_reference": "91:5",
      "surah_number": 91,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "english_translation": "Consider the sky and its wondrous make,"
    },
    {
      "ayah_reference": "91:6",
      "surah_number": 91,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "english_translation": "and the earth and all its expanse!"
    },
    {
      "ayah_reference": "91:7",
      "surah_number": 91,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا",
      "english_translation": "Consider the human self, and how it is formed in accordance with what it is meant to be,"
    },
    {
      "ayah_reference": "91:8",
      "surah_number": 91,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "english_translation": "and how it is imbued with moral failings as well as with consciousness of God!"
    },
    {
      "ayah_reference": "91:9",
      "surah_number": 91,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "english_translation": "To a happy state shall indeed attain he who causes this [self] to grow in purity,"
    },
    {
      "ayah_reference": "91:10",
      "surah_number": 91,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "english_translation": "and truly lost is he who buries it [in darkness]."
    },
    {
      "ayah_reference": "91:11",
      "surah_number": 91,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "english_translation": "TO [THIS] TRUTH gave the lie, in their overweening arrogance, [the tribe of] Thamud,"
    },
    {
      "ayah_reference": "91:12",
      "surah_number": 91,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "english_translation": "when that most hapless wretch from among them rushed forward [to commit his evil deed],"
    },
    {
      "ayah_reference": "91:13",
      "surah_number": 91,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا",
      "english_translation": "although God's apostle had told them, \"It is a she-camel belonging to God, so let her drink [and do her no harm]!\""
    },
    {
      "ayah_reference": "91:14",
      "surah_number": 91,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "english_translation": "But they gave him the lie, and cruelly slaughtered her - whereupon their Sustainer visited them with utter destruction for this their sin, destroying them all alike:"
    },
    {
      "ayah_reference": "91:15",
      "surah_number": 91,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 238,
      "manzil": 7,
      "page": 595,
      "ruku": 533,
      "sajda": false,
      "arabic_text": "وَلَا يَخَافُ عُقْبَٰهَا",
      "english_translation": "for none [of them] had any fear of what might befall them."
    }
  ]
}