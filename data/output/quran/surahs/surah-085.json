{
  "surah_number": 85,
  "surah_name_arabic": "سُورَةُ البُرُوجِ",
  "surah_name_english": "Al-Burooj",
  "surah_name_english_translation": "The Constellations",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "85:1",
      "surah_number": 85,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
      "english_translation": "CONSIDER the sky full of great constellations,"
    },
    {
      "ayah_reference": "85:2",
      "surah_number": 85,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
      "english_translation": "and [then bethink thyself of] the promised Day,"
    },
    {
      "ayah_reference": "85:3",
      "surah_number": 85,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "وَشَاهِدٍۢ وَمَشْهُودٍۢ",
      "english_translation": "and [of] Him who witnesses [all], and [of] that unto which witness is borne [by Him]!"
    },
    {
      "ayah_reference": "85:4",
      "surah_number": 85,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ",
      "english_translation": "THEY DESTROY [but] themselves, they who would ready a pit"
    },
    {
      "ayah_reference": "85:5",
      "surah_number": 85,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ",
      "english_translation": "of fire fiercely burning [for all who have attained to faith]!"
    },
    {
      "ayah_reference": "85:6",
      "surah_number": 85,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ",
      "english_translation": "Lo! [With glee do] they contemplate that [fire],"
    },
    {
      "ayah_reference": "85:7",
      "surah_number": 85,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ",
      "english_translation": "fully conscious of what they are doing to the believers,"
    },
    {
      "ayah_reference": "85:8",
      "surah_number": 85,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
      "english_translation": "whom they hate for no other reason than that they believe in God, the Almighty, the One to whom all praise is due,"
    },
    {
      "ayah_reference": "85:9",
      "surah_number": 85,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ",
      "english_translation": "[and] to whom the dominion of the heavens and the earth belongs. But God is witness unto everything!"
    },
    {
      "ayah_reference": "85:10",
      "surah_number": 85,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
      "english_translation": "Verily, as for those who persecute believing men and believing women, and thereafter do not repent, hell's suffering awaits them: yea, suffering through fire awaits them!"
    },
    {
      "ayah_reference": "85:11",
      "surah_number": 85,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
      "english_translation": "[But,] verily, they who attain to faith and do righteous deeds shall [in the life to come] have gardens through which running waters flow - that triumph most great!"
    },
    {
      "ayah_reference": "85:12",
      "surah_number": 85,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
      "english_translation": "VERILY, thy Sustainer's grip is exceedingly strong!"
    },
    {
      "ayah_reference": "85:13",
      "surah_number": 85,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
      "english_translation": "Behold, it is He who creates [man] in the first instance, and He [it is who] will bring him forth anew."
    },
    {
      "ayah_reference": "85:14",
      "surah_number": 85,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
      "english_translation": "And He alone is truly-forgiving, all-embracing in His love,"
    },
    {
      "ayah_reference": "85:15",
      "surah_number": 85,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
      "english_translation": "in sublime almightiness enthroned,"
    },
    {
      "ayah_reference": "85:16",
      "surah_number": 85,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "فَعَّالٌۭ لِّمَا يُرِيدُ",
      "english_translation": "a sovereign doer of whatever He wills."
    },
    {
      "ayah_reference": "85:17",
      "surah_number": 85,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ",
      "english_translation": "HAS IT ever come within thy ken, the story of the [sinful] hosts"
    },
    {
      "ayah_reference": "85:18",
      "surah_number": 85,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "فِرْعَوْنَ وَثَمُودَ",
      "english_translation": "of Pharaoh, and of [the tribe of] Thamud?"
    },
    {
      "ayah_reference": "85:19",
      "surah_number": 85,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ",
      "english_translation": "And yet, they who are bent on denying the truth persist in giving it the lie:"
    },
    {
      "ayah_reference": "85:20",
      "surah_number": 85,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ",
      "english_translation": "but all the while God encompasses them [with His knowledge and might] without their being aware of it."
    },
    {
      "ayah_reference": "85:21",
      "surah_number": 85,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ",
      "english_translation": "Nay, but this [divine writ which they reject] is a discourse sublime,"
    },
    {
      "ayah_reference": "85:22",
      "surah_number": 85,
      "ayah_number": 22,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "sajda": false,
      "arabic_text": "فِى لَوْحٍۢ مَّحْفُوظٍۭ",
      "english_translation": "upon an imperishable tablet [inscribed]."
    }
  ]
}