{
  "surah_number": 87,
  "surah_name_arabic": "سُورَةُ الأَعۡلَىٰ",
  "surah_name_english": "Al-A'laa",
  "surah_name_english_translation": "The Most High",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "87:1",
      "surah_number": 87,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "english_translation": "EXTOL the limitless glory of thy Sustainer's name: [the glory of] the Al-Highest,"
    },
    {
      "ayah_reference": "87:2",
      "surah_number": 87,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "english_translation": "who creates [every thing], and thereupon forms it in accordance with what it is meant to be,"
    },
    {
      "ayah_reference": "87:3",
      "surah_number": 87,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "english_translation": "and who determines the nature [of all that exists], and thereupon guides it [towards its fulfilment],"
    },
    {
      "ayah_reference": "87:4",
      "surah_number": 87,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "english_translation": "and who brings forth herbage,"
    },
    {
      "ayah_reference": "87:5",
      "surah_number": 87,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
      "english_translation": "and thereupon causes it to decay into rust-brown stubble!"
    },
    {
      "ayah_reference": "87:6",
      "surah_number": 87,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "english_translation": "WE SHALL teach thee, and thou wilt not forget [aught of what thou art taught],"
    },
    {
      "ayah_reference": "87:7",
      "surah_number": 87,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
      "english_translation": "save what God may will [thee to forget] - for, verily, He [alone] knows all that is open to [man's] perception as well as all that is hidden [from it]"
    },
    {
      "ayah_reference": "87:8",
      "surah_number": 87,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
      "english_translation": "and [thus] shall We make easy for thee the path towards [ultimate] ease."
    },
    {
      "ayah_reference": "87:9",
      "surah_number": 87,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
      "english_translation": "REMIND, THEN, [others of the truth, regardless of] whether this reminding [would seem to] be of use [or not]:"
    },
    {
      "ayah_reference": "87:10",
      "surah_number": 87,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
      "english_translation": "in mind will keep it he who stands in awe [of God],"
    },
    {
      "ayah_reference": "87:11",
      "surah_number": 87,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
      "english_translation": "but aloof from it will remain that most hapless wretch –"
    },
    {
      "ayah_reference": "87:12",
      "surah_number": 87,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
      "english_translation": "he who [in the life to come] shall have to endure the great fire"
    },
    {
      "ayah_reference": "87:13",
      "surah_number": 87,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
      "english_translation": "wherein he will neither die nor remain alive."
    },
    {
      "ayah_reference": "87:14",
      "surah_number": 87,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "english_translation": "To happiness [in the life to come] will indeed attain he who attains to purity [in this world],"
    },
    {
      "ayah_reference": "87:15",
      "surah_number": 87,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
      "english_translation": "and remembers his Sustainer's name, and prays [unto Him]."
    },
    {
      "ayah_reference": "87:16",
      "surah_number": 87,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "english_translation": "But nay, [O men,] you prefer the life of this world,"
    },
    {
      "ayah_reference": "87:17",
      "surah_number": 87,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ",
      "english_translation": "although the life to come is better and more enduring."
    },
    {
      "ayah_reference": "87:18",
      "surah_number": 87,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
      "english_translation": "Verily, [all] this has indeed been [said] in the earlier revelations –"
    },
    {
      "ayah_reference": "87:19",
      "surah_number": 87,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 237,
      "manzil": 7,
      "page": 592,
      "ruku": 529,
      "sajda": false,
      "arabic_text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
      "english_translation": "the revelations of Abraham and Moses."
    }
  ]
}