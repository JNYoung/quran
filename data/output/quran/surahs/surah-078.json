{
  "surah_number": 78,
  "surah_name_arabic": "سُورَةُ النَّبَإِ",
  "surah_name_english": "An-Naba",
  "surah_name_english_translation": "The Announcement",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "78:1",
      "surah_number": 78,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ",
      "english_translation": "ABOUT WHAT do they [most often] ask one another?"
    },
    {
      "ayah_reference": "78:2",
      "surah_number": 78,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
      "english_translation": "About the awesome tiding [of resurrection],"
    },
    {
      "ayah_reference": "78:3",
      "surah_number": 78,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
      "english_translation": "on which they [so utterly] disagree."
    },
    {
      "ayah_reference": "78:4",
      "surah_number": 78,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "كَلَّا سَيَعْلَمُونَ",
      "english_translation": "Nay, but in time they will come to understand [it]!"
    },
    {
      "ayah_reference": "78:5",
      "surah_number": 78,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
      "english_translation": "And once again: Nay, but in time they will come to understand!"
    },
    {
      "ayah_reference": "78:6",
      "surah_number": 78,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا",
      "english_translation": "HAVE WE NOT made the earth a resting-place [for you],"
    },
    {
      "ayah_reference": "78:7",
      "surah_number": 78,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَٱلْجِبَالَ أَوْتَادًۭا",
      "english_translation": "and the mountains [its] pegs?"
    },
    {
      "ayah_reference": "78:8",
      "surah_number": 78,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا",
      "english_translation": "And We have created you in pairs;"
    },
    {
      "ayah_reference": "78:9",
      "surah_number": 78,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا",
      "english_translation": "and We have made your sleep [a symbol of] death"
    },
    {
      "ayah_reference": "78:10",
      "surah_number": 78,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا",
      "english_translation": "and made the night [its] cloak"
    },
    {
      "ayah_reference": "78:11",
      "surah_number": 78,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا",
      "english_translation": "and made the day [a symbol of] life."
    },
    {
      "ayah_reference": "78:12",
      "surah_number": 78,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا",
      "english_translation": "And We have built above you seven firmaments,"
    },
    {
      "ayah_reference": "78:13",
      "surah_number": 78,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا",
      "english_translation": "and have placed [therein the sun,] a lamp full of blazing splendour."
    },
    {
      "ayah_reference": "78:14",
      "surah_number": 78,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا",
      "english_translation": "And from the wind-driven clouds We send down waters pouring in abundance,"
    },
    {
      "ayah_reference": "78:15",
      "surah_number": 78,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا",
      "english_translation": "so that We might bring forth thereby grain, and herbs,"
    },
    {
      "ayah_reference": "78:16",
      "surah_number": 78,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَجَنَّٰتٍ أَلْفَافًا",
      "english_translation": "and gardens dense with follage."
    },
    {
      "ayah_reference": "78:17",
      "surah_number": 78,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا",
      "english_translation": "VERILY, the Day of Distinction [between the true and the false] has indeed its appointed time:"
    },
    {
      "ayah_reference": "78:18",
      "surah_number": 78,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا",
      "english_translation": "the Day when the trumpet [of resurrection] is sounded and you all come forward in multitudes;"
    },
    {
      "ayah_reference": "78:19",
      "surah_number": 78,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا",
      "english_translation": "and when the skies are opened and become [as wide-flung] gates;"
    },
    {
      "ayah_reference": "78:20",
      "surah_number": 78,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "english_translation": "and when the mountains are made to vanish as if they had been a mirage."
    },
    {
      "ayah_reference": "78:21",
      "surah_number": 78,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا",
      "english_translation": "[On that Day,] verily, hell will lie in wait [for those who deny the truth] –"
    },
    {
      "ayah_reference": "78:22",
      "surah_number": 78,
      "ayah_number": 22,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "لِّلطَّٰغِينَ مَـَٔابًۭا",
      "english_translation": "a goal for all who are wont to transgress the bounds of what is right!"
    },
    {
      "ayah_reference": "78:23",
      "surah_number": 78,
      "ayah_number": 23,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا",
      "english_translation": "In it shall they remain for a long time."
    },
    {
      "ayah_reference": "78:24",
      "surah_number": 78,
      "ayah_number": 24,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا",
      "english_translation": "Neither coolness shall they taste therein nor any [thirst-quenching] drink –"
    },
    {
      "ayah_reference": "78:25",
      "surah_number": 78,
      "ayah_number": 25,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا",
      "english_translation": "only burning despair and ice-cold darkness:"
    },
    {
      "ayah_reference": "78:26",
      "surah_number": 78,
      "ayah_number": 26,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "جَزَآءًۭ وِفَاقًا",
      "english_translation": "a meet requital [for their sins]!"
    },
    {
      "ayah_reference": "78:27",
      "surah_number": 78,
      "ayah_number": 27,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا",
      "english_translation": "Behold, they were not expecting to be called to account,"
    },
    {
      "ayah_reference": "78:28",
      "surah_number": 78,
      "ayah_number": 28,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا",
      "english_translation": "having given the lie to Our messages one and all:"
    },
    {
      "ayah_reference": "78:29",
      "surah_number": 78,
      "ayah_number": 29,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا",
      "english_translation": "but We have placed on record every single thing [of what they did]."
    },
    {
      "ayah_reference": "78:30",
      "surah_number": 78,
      "ayah_number": 30,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "sajda": false,
      "arabic_text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
      "english_translation": "[And so We shall say:] \"Taste, then, [the fruit of your evil doings,] for now We shall bestow on you nothing but more and more suffering!\""
    },
    {
      "ayah_reference": "78:31",
      "surah_number": 78,
      "ayah_number": 31,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "english_translation": "[But,] verily for the God-conscious there is supreme fulfilment in store:"
    },
    {
      "ayah_reference": "78:32",
      "surah_number": 78,
      "ayah_number": 32,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "حَدَآئِقَ وَأَعْنَٰبًۭا",
      "english_translation": "luxuriant gardens and vinyards,"
    },
    {
      "ayah_reference": "78:33",
      "surah_number": 78,
      "ayah_number": 33,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "وَكَوَاعِبَ أَتْرَابًۭا",
      "english_translation": "and splendid companions well matched,"
    },
    {
      "ayah_reference": "78:34",
      "surah_number": 78,
      "ayah_number": 34,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "وَكَأْسًۭا دِهَاقًۭا",
      "english_translation": "and a cup [of happiness] overflowing."
    },
    {
      "ayah_reference": "78:35",
      "surah_number": 78,
      "ayah_number": 35,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا",
      "english_translation": "No empty talk will they hear in that [paradise], nor any lie."
    },
    {
      "ayah_reference": "78:36",
      "surah_number": 78,
      "ayah_number": 36,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا",
      "english_translation": "[All this will be] a reward from thy Sustainer, a gift in accordance with [His Own] reckoning –"
    },
    {
      "ayah_reference": "78:37",
      "surah_number": 78,
      "ayah_number": 37,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا",
      "english_translation": "[a reward from] the Sustainer of the heavens and the earth and all that is between them, the Most Gracious! [And] none shall have it in their power to raise their voices unto Him"
    },
    {
      "ayah_reference": "78:38",
      "surah_number": 78,
      "ayah_number": 38,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا",
      "english_translation": "on the Day when all [human] souls and all the angels will stand up in ranks: none will speak but he to whom the Most Gracious will have given leave; and [everyone] will say [only] what is right."
    },
    {
      "ayah_reference": "78:39",
      "surah_number": 78,
      "ayah_number": 39,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
      "english_translation": "That will be the Day of Ultimate Truth: whoever wills, then, let him take the path that leads towards his Sustainer!"
    },
    {
      "ayah_reference": "78:40",
      "surah_number": 78,
      "ayah_number": 40,
      "juz": 30,
      "hizb_quarter": 233,
      "manzil": 7,
      "page": 583,
      "ruku": 519,
      "sajda": false,
      "arabic_text": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
      "english_translation": "Verily, We have warned you of suffering near at hand - [suffering] on the Day when man shall [clearly] see what his hands have sent ahead, and when he who has denied the truth shall say, \"Oh, would that I were mere dust...!\""
    }
  ]
}