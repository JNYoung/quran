{
  "surah_number": 96,
  "surah_name_arabic": "سُورَةُ العَلَقِ",
  "surah_name_english": "Al-Alaq",
  "surah_name_english_translation": "The Clot",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "96:1",
      "surah_number": 96,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "english_translation": "READ in the name of thy Sustainer, who has-"
    },
    {
      "ayah_reference": "96:2",
      "surah_number": 96,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ",
      "english_translation": "created man out of a germ-cell"
    },
    {
      "ayah_reference": "96:3",
      "surah_number": 96,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "english_translation": "Read - for thy Sustainer is the Most Bountiful One"
    },
    {
      "ayah_reference": "96:4",
      "surah_number": 96,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "english_translation": "who has taught [man] the use of the pen –"
    },
    {
      "ayah_reference": "96:5",
      "surah_number": 96,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ",
      "english_translation": "taught man what he did not know!"
    },
    {
      "ayah_reference": "96:6",
      "surah_number": 96,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ",
      "english_translation": "Nay, verily, man becomes grossly overweening"
    },
    {
      "ayah_reference": "96:7",
      "surah_number": 96,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "english_translation": "whenever he believes himself to be self-sufficient:"
    },
    {
      "ayah_reference": "96:8",
      "surah_number": 96,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "english_translation": "for, behold, unto thy Sustainer all must return."
    },
    {
      "ayah_reference": "96:9",
      "surah_number": 96,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "english_translation": "HAST THOU ever considered him who tries to prevent"
    },
    {
      "ayah_reference": "96:10",
      "surah_number": 96,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "عَبْدًا إِذَا صَلَّىٰٓ",
      "english_translation": "a servant [of God] from praying?"
    },
    {
      "ayah_reference": "96:11",
      "surah_number": 96,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "english_translation": "Hast thou considered whether he is on the right way,"
    },
    {
      "ayah_reference": "96:12",
      "surah_number": 96,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "english_translation": "or is concerned with God-consciousness?"
    },
    {
      "ayah_reference": "96:13",
      "surah_number": 96,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "english_translation": "Hast thou considered whether he may [not] be giving the lie to the truth and turning his back [upon it]?"
    },
    {
      "ayah_reference": "96:14",
      "surah_number": 96,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "english_translation": "Does he, then, not know that God sees [all]?"
    },
    {
      "ayah_reference": "96:15",
      "surah_number": 96,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "english_translation": "Nay, if he desist not, We shall most surely drag him down upon his forehead"
    },
    {
      "ayah_reference": "96:16",
      "surah_number": 96,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ",
      "english_translation": "the lying, rebellious forehead! –"
    },
    {
      "ayah_reference": "96:17",
      "surah_number": 96,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "فَلْيَدْعُ نَادِيَهُۥ",
      "english_translation": "and then let him summon [to his aid] the counsels of his own [spurious] wisdom,"
    },
    {
      "ayah_reference": "96:18",
      "surah_number": 96,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": false,
      "arabic_text": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "english_translation": "[the while] We shall summon the forces of heavenly chastisement!"
    },
    {
      "ayah_reference": "96:19",
      "surah_number": 96,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "sajda": {
        "id": 15,
        "recommended": false,
        "obligatory": true
      },
      "arabic_text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "english_translation": "Nay, pay thou no heed to him, but prostrate thyself [before God] and draw close [unto Him]!"
    }
  ]
}