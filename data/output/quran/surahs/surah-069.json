{
  "surah_number": 69,
  "surah_name_arabic": "سُورَةُ الحَاقَّةِ",
  "surah_name_english": "Al-Haaqqa",
  "surah_name_english_translation": "The Reality",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "69:1",
      "surah_number": 69,
      "ayah_number": 1,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ",
      "english_translation": "OH, THE LAYING-BARE of the truth!"
    },
    {
      "ayah_reference": "69:2",
      "surah_number": 69,
      "ayah_number": 2,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "مَا ٱلْحَآقَّةُ",
      "english_translation": "How awesome that laying-bare of the truth!"
    },
    {
      "ayah_reference": "69:3",
      "surah_number": 69,
      "ayah_number": 3,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ",
      "english_translation": "And what could make thee conceive what that laying-bare of the truth will be?"
    },
    {
      "ayah_reference": "69:4",
      "surah_number": 69,
      "ayah_number": 4,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
      "english_translation": "THE LIE gave [the tribes of] Thamud and ‘Ad to [all tidings of] that sudden calamity!"
    },
    {
      "ayah_reference": "69:5",
      "surah_number": 69,
      "ayah_number": 5,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
      "english_translation": "Now as for the Thamud - they were destroyed by a violent upheaval [of the earth];"
    },
    {
      "ayah_reference": "69:6",
      "surah_number": 69,
      "ayah_number": 6,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ",
      "english_translation": "and as for the ‘Ad - they were destroyed by a storm wind furiously raging,"
    },
    {
      "ayah_reference": "69:7",
      "surah_number": 69,
      "ayah_number": 7,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍۢ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًۭا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ",
      "english_translation": "which He willed against them for seven nights and eight days without cease, so that in the end thou couldst see those people laid low [in death], as though they were so many [uprooted] trunks of hollow palm trees:"
    },
    {
      "ayah_reference": "69:8",
      "surah_number": 69,
      "ayah_number": 8,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 566,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍۢ",
      "english_translation": "and dost thou now see any remnant of them?"
    },
    {
      "ayah_reference": "69:9",
      "surah_number": 69,
      "ayah_number": 9,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ",
      "english_translation": "And there was Pharaoh, too, and [many of] those who lived before him, and the cities that were overthrown - [all of them] indulged in sin upon sin"
    },
    {
      "ayah_reference": "69:10",
      "surah_number": 69,
      "ayah_number": 10,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً",
      "english_translation": "and rebelled against their Sustainer's apostles: and so He took them to task with a punishing grasp exceedingly severe!"
    },
    {
      "ayah_reference": "69:11",
      "surah_number": 69,
      "ayah_number": 11,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ",
      "english_translation": "[And] behold: when the waters [of Noah's flood] burst beyond all limits, it was We who caused you to be borne [to safety] in that floating ark,"
    },
    {
      "ayah_reference": "69:12",
      "surah_number": 69,
      "ayah_number": 12,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ",
      "english_translation": "so that We might make all this a [lasting] reminder to you all, and that every wide-awake ear might consciously take it in."
    },
    {
      "ayah_reference": "69:13",
      "surah_number": 69,
      "ayah_number": 13,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌۭ وَٰحِدَةٌۭ",
      "english_translation": "Hence, [bethink yourselves of the Last Hour,] when the trumpet [of judgment] shall be sounded with a single blast,"
    },
    {
      "ayah_reference": "69:14",
      "surah_number": 69,
      "ayah_number": 14,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ",
      "english_translation": "and the earth and the mountains shall be lifted up and crushed with a single stroke!"
    },
    {
      "ayah_reference": "69:15",
      "surah_number": 69,
      "ayah_number": 15,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فَيَوْمَئِذٍۢ وَقَعَتِ ٱلْوَاقِعَةُ",
      "english_translation": "And so, that which must come to pass will on that day have come to pass;"
    },
    {
      "ayah_reference": "69:16",
      "surah_number": 69,
      "ayah_number": 16,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ",
      "english_translation": "and the sky will be rent asunder - for, frail will it have become on that Day -;"
    },
    {
      "ayah_reference": "69:17",
      "surah_number": 69,
      "ayah_number": 17,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ ثَمَٰنِيَةٌۭ",
      "english_translation": "and the angels [will appear] at its ends, and, above them, eight will bear aloft on that Day the throne of thy Sustainer’s almightiness…"
    },
    {
      "ayah_reference": "69:18",
      "surah_number": 69,
      "ayah_number": 18,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "يَوْمَئِذٍۢ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌۭ",
      "english_translation": "On that Day you shall be brought to judgment: not [even] the most hidden of your deeds will remain hidden."
    },
    {
      "ayah_reference": "69:19",
      "surah_number": 69,
      "ayah_number": 19,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ",
      "english_translation": "Now as for him whose record shall be placed in his right hand, he will exclaim: \"Come you all!\" Read this my record!"
    },
    {
      "ayah_reference": "69:20",
      "surah_number": 69,
      "ayah_number": 20,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ",
      "english_translation": "Behold, I did know that [one day] I would have to face my account!"
    },
    {
      "ayah_reference": "69:21",
      "surah_number": 69,
      "ayah_number": 21,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ",
      "english_translation": "And so he will find himself in a happy state of life,"
    },
    {
      "ayah_reference": "69:22",
      "surah_number": 69,
      "ayah_number": 22,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فِى جَنَّةٍ عَالِيَةٍۢ",
      "english_translation": "in a lofty paradise,"
    },
    {
      "ayah_reference": "69:23",
      "surah_number": 69,
      "ayah_number": 23,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "قُطُوفُهَا دَانِيَةٌۭ",
      "english_translation": "with its fruits within easy reach."
    },
    {
      "ayah_reference": "69:24",
      "surah_number": 69,
      "ayah_number": 24,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ",
      "english_translation": "[And all who are thus blest will be told:] \"Eat and drink with good cheer in return for all [the good deeds] that you have sent ahead in days gone by!\""
    },
    {
      "ayah_reference": "69:25",
      "surah_number": 69,
      "ayah_number": 25,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ",
      "english_translation": "But as for him whose record shall be placed in his left hand, he will exclaim: \"Oh, would that I had never been shown this my record,"
    },
    {
      "ayah_reference": "69:26",
      "surah_number": 69,
      "ayah_number": 26,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ",
      "english_translation": "and neither known this my account!"
    },
    {
      "ayah_reference": "69:27",
      "surah_number": 69,
      "ayah_number": 27,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ",
      "english_translation": "Oh, would that this [death of mine] had been the end of me!"
    },
    {
      "ayah_reference": "69:28",
      "surah_number": 69,
      "ayah_number": 28,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ",
      "english_translation": "Of no avail to me is all that I have [ever] possessed,"
    },
    {
      "ayah_reference": "69:29",
      "surah_number": 69,
      "ayah_number": 29,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "هَلَكَ عَنِّى سُلْطَٰنِيَهْ",
      "english_translation": "[and] all my power of argument has died away from me!\""
    },
    {
      "ayah_reference": "69:30",
      "surah_number": 69,
      "ayah_number": 30,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "خُذُوهُ فَغُلُّوهُ",
      "english_translation": "Thereupon the command will go forth:] \"Lay hold of him, and shackle him,"
    },
    {
      "ayah_reference": "69:31",
      "surah_number": 69,
      "ayah_number": 31,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ",
      "english_translation": "and then let him enter hell,"
    },
    {
      "ayah_reference": "69:32",
      "surah_number": 69,
      "ayah_number": 32,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ",
      "english_translation": "and then thrust him into a chain [of other sinners like him - a chain] the length whereof is seventy cubits:"
    },
    {
      "ayah_reference": "69:33",
      "surah_number": 69,
      "ayah_number": 33,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ",
      "english_translation": "for, behold, he did not believe in God, the Tremendous,"
    },
    {
      "ayah_reference": "69:34",
      "surah_number": 69,
      "ayah_number": 34,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 567,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "english_translation": "and did not feel any urge to feed the needy:"
    },
    {
      "ayah_reference": "69:35",
      "surah_number": 69,
      "ayah_number": 35,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ",
      "english_translation": "and so, no friend has here today,"
    },
    {
      "ayah_reference": "69:36",
      "surah_number": 69,
      "ayah_number": 36,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ",
      "english_translation": "nor any food save the filth"
    },
    {
      "ayah_reference": "69:37",
      "surah_number": 69,
      "ayah_number": 37,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "sajda": false,
      "arabic_text": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ",
      "english_translation": "which none but the sinners eat!\""
    },
    {
      "ayah_reference": "69:38",
      "surah_number": 69,
      "ayah_number": 38,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ",
      "english_translation": "BUT NAY! I call to witness an that you can see,"
    },
    {
      "ayah_reference": "69:39",
      "surah_number": 69,
      "ayah_number": 39,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "وَمَا لَا تُبْصِرُونَ",
      "english_translation": "as well as all that you cannot see!"
    },
    {
      "ayah_reference": "69:40",
      "surah_number": 69,
      "ayah_number": 40,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ",
      "english_translation": "Behold, this [Qur’an] is indeed the [inspired] word of a noble apostle,"
    },
    {
      "ayah_reference": "69:41",
      "surah_number": 69,
      "ayah_number": 41,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ",
      "english_translation": "and is not – however little you may [be prepared to] believe it - the word of a poet;"
    },
    {
      "ayah_reference": "69:42",
      "surah_number": 69,
      "ayah_number": 42,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ",
      "english_translation": "and neither is it - however little you may [be prepared to] take it to heart - the word of a soothsayer:"
    },
    {
      "ayah_reference": "69:43",
      "surah_number": 69,
      "ayah_number": 43,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ",
      "english_translation": "[it is] a revelation from the Sustainer of all the worlds."
    },
    {
      "ayah_reference": "69:44",
      "surah_number": 69,
      "ayah_number": 44,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ",
      "english_translation": "Now if he [whom We have entrusted with it] had dared to attribute some [of his own] sayings unto Us,"
    },
    {
      "ayah_reference": "69:45",
      "surah_number": 69,
      "ayah_number": 45,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ",
      "english_translation": "We would indeed have seized him by his right hand,"
    },
    {
      "ayah_reference": "69:46",
      "surah_number": 69,
      "ayah_number": 46,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ",
      "english_translation": "and would indeed have cut his life-vein."
    },
    {
      "ayah_reference": "69:47",
      "surah_number": 69,
      "ayah_number": 47,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ",
      "english_translation": "and none of you could have saved him!"
    },
    {
      "ayah_reference": "69:48",
      "surah_number": 69,
      "ayah_number": 48,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ",
      "english_translation": "And, verily, this [Qur’an] is a reminder to all the God-conscious!"
    },
    {
      "ayah_reference": "69:49",
      "surah_number": 69,
      "ayah_number": 49,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",
      "english_translation": "And, behold, well do We know that among you are such as will give the lie to it:"
    },
    {
      "ayah_reference": "69:50",
      "surah_number": 69,
      "ayah_number": 50,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ",
      "english_translation": "yet, behold, this [rejection] will indeed become a source of bitter regret for all who deny the truth [of God's revelation] –"
    },
    {
      "ayah_reference": "69:51",
      "surah_number": 69,
      "ayah_number": 51,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ",
      "english_translation": "for, verily, it is truth absolute!"
    },
    {
      "ayah_reference": "69:52",
      "surah_number": 69,
      "ayah_number": 52,
      "juz": 29,
      "hizb_quarter": 227,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "sajda": false,
      "arabic_text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "english_translation": "Extol, then the limitless glory of thy Sustainer's mighty name!"
    }
  ]
}