{
  "surah_number": 102,
  "surah_name_arabic": "سُورَةُ التَّكَاثُرِ",
  "surah_name_english": "At-Takaathur",
  "surah_name_english_translation": "Competition",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "102:1",
      "surah_number": 102,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ",
      "english_translation": "YOU ARE OBSESSED by greed for more and more"
    },
    {
      "ayah_reference": "102:2",
      "surah_number": 102,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "sajda": false,
      "arabic_text": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ",
      "english_translation": "until you go down to your graves."
    },
    {
      "ayah_reference": "102:3",
      "surah_number": 102,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "sajda": false,
      "arabic_text": "كَلَّا سَوْفَ تَعْلَمُونَ",
      "english_translation": "Nay, in time you will come to understand!"
    },
    {
      "ayah_reference": "102:4",
      "surah_number": 102,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "sajda": false,
      "arabic_text": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
      "english_translation": "And once again: Nay, in time you will come to understand!"
    },
    {
      "ayah_reference": "102:5",
      "surah_number": 102,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "sajda": false,
      "arabic_text": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
      "english_translation": "Nay, if you could but understand [it] with an understanding [born] of certainty,"
    },
    {
      "ayah_reference": "102:6",
      "surah_number": 102,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "sajda": false,
      "arabic_text": "لَتَرَوُنَّ ٱلْجَحِيمَ",
      "english_translation": "you would indeed, most surely, behold the blazing fire [of hell]!"
    },
    {
      "ayah_reference": "102:7",
      "surah_number": 102,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "sajda": false,
      "arabic_text": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ",
      "english_translation": "In the end you will indeed, most surely, behold it with the eye of certainty:"
    },
    {
      "ayah_reference": "102:8",
      "surah_number": 102,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "sajda": false,
      "arabic_text": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "english_translation": "and on that Day you will most surely be called to account for [what you did with] the boon of life!"
    }
  ]
}