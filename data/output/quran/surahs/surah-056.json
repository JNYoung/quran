{
  "surah_number": 56,
  "surah_name_arabic": "سُورَةُ الوَاقِعَةِ",
  "surah_name_english": "Al-Waaqia",
  "surah_name_english_translation": "The Inevitable",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "56:1",
      "surah_number": 56,
      "ayah_number": 1,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
      "english_translation": "WHEN THAT which must come to pass [at last] comes to pass,"
    },
    {
      "ayah_reference": "56:2",
      "surah_number": 56,
      "ayah_number": 2,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
      "english_translation": "there will be nought that could give the lie to its having come to pass,"
    },
    {
      "ayah_reference": "56:3",
      "surah_number": 56,
      "ayah_number": 3,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "خَافِضَةٌۭ رَّافِعَةٌ",
      "english_translation": "abasing [some], exalting [others]!"
    },
    {
      "ayah_reference": "56:4",
      "surah_number": 56,
      "ayah_number": 4,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا",
      "english_translation": "When the earth is shaken with a shaking [severe],"
    },
    {
      "ayah_reference": "56:5",
      "surah_number": 56,
      "ayah_number": 5,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا",
      "english_translation": "and the mountains are shattered into [countless] shards,"
    },
    {
      "ayah_reference": "56:6",
      "surah_number": 56,
      "ayah_number": 6,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا",
      "english_translation": "so that they become as scat­tered dust –"
    },
    {
      "ayah_reference": "56:7",
      "surah_number": 56,
      "ayah_number": 7,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ",
      "english_translation": "[on that Day,] then, shall you be [divided into] three kinds."
    },
    {
      "ayah_reference": "56:8",
      "surah_number": 56,
      "ayah_number": 8,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ",
      "english_translation": "Thus, there shall be such as will have attained to what is right: oh, how [happy] will be they who have attained to what is right!"
    },
    {
      "ayah_reference": "56:9",
      "surah_number": 56,
      "ayah_number": 9,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",
      "english_translation": "And there shall be such as will have lost them­selves in evil: oh, how [unhappy] will be they who have lost themselves in evil!"
    },
    {
      "ayah_reference": "56:10",
      "surah_number": 56,
      "ayah_number": 10,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ",
      "english_translation": "But the foremost shall be [they who in life were] the foremost [in faith and good works]:"
    },
    {
      "ayah_reference": "56:11",
      "surah_number": 56,
      "ayah_number": 11,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ",
      "english_translation": "they who were [always] drawn close unto God!"
    },
    {
      "ayah_reference": "56:12",
      "surah_number": 56,
      "ayah_number": 12,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "فِى جَنَّٰتِ ٱلنَّعِيمِ",
      "english_translation": "In gardens of bliss [will they dwell] -"
    },
    {
      "ayah_reference": "56:13",
      "surah_number": 56,
      "ayah_number": 13,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ",
      "english_translation": "a good many of those of olden times,"
    },
    {
      "ayah_reference": "56:14",
      "surah_number": 56,
      "ayah_number": 14,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ",
      "english_translation": "but [only] a few of later times."
    },
    {
      "ayah_reference": "56:15",
      "surah_number": 56,
      "ayah_number": 15,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ",
      "english_translation": "[They will be seated] on gold-encrusted thrones of happiness,"
    },
    {
      "ayah_reference": "56:16",
      "surah_number": 56,
      "ayah_number": 16,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ",
      "english_translation": "reclining upon them, facing one another [in love]."
    },
    {
      "ayah_reference": "56:17",
      "surah_number": 56,
      "ayah_number": 17,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ",
      "english_translation": "Immortal youths will wait upon them"
    },
    {
      "ayah_reference": "56:18",
      "surah_number": 56,
      "ayah_number": 18,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ",
      "english_translation": "with goblets, and ewers, and cups filled with water from unsullied springs"
    },
    {
      "ayah_reference": "56:19",
      "surah_number": 56,
      "ayah_number": 19,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
      "english_translation": "by which their minds will not be clouded and which will not make them drunk;"
    },
    {
      "ayah_reference": "56:20",
      "surah_number": 56,
      "ayah_number": 20,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ",
      "english_translation": "and with fruit of any kind that they may choose,"
    },
    {
      "ayah_reference": "56:21",
      "surah_number": 56,
      "ayah_number": 21,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ",
      "english_translation": "and with the flesh of any fowl that they may desire."
    },
    {
      "ayah_reference": "56:22",
      "surah_number": 56,
      "ayah_number": 22,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَحُورٌ عِينٌۭ",
      "english_translation": "And [with them will be their] companions pure, most beautiful of eye,"
    },
    {
      "ayah_reference": "56:23",
      "surah_number": 56,
      "ayah_number": 23,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
      "english_translation": "like unto pearls [still] hidden in their shells."
    },
    {
      "ayah_reference": "56:24",
      "surah_number": 56,
      "ayah_number": 24,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
      "english_translation": "[And this will be] a reward for what they did [in life]."
    },
    {
      "ayah_reference": "56:25",
      "surah_number": 56,
      "ayah_number": 25,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا",
      "english_translation": "No empty talk will they hear there, nor any call to sin,"
    },
    {
      "ayah_reference": "56:26",
      "surah_number": 56,
      "ayah_number": 26,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا",
      "english_translation": "but only the tiding of inner soundness and peace."
    },
    {
      "ayah_reference": "56:27",
      "surah_number": 56,
      "ayah_number": 27,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ",
      "english_translation": "NOW AS FOR those who have attained to righteous­ness - what of those who have attained to righteous­ness?"
    },
    {
      "ayah_reference": "56:28",
      "surah_number": 56,
      "ayah_number": 28,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "فِى سِدْرٍۢ مَّخْضُودٍۢ",
      "english_translation": "[They, too, will find themselves] amidst fruit- laden lote-trees,"
    },
    {
      "ayah_reference": "56:29",
      "surah_number": 56,
      "ayah_number": 29,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَطَلْحٍۢ مَّنضُودٍۢ",
      "english_translation": "and acacias flower-clad,"
    },
    {
      "ayah_reference": "56:30",
      "surah_number": 56,
      "ayah_number": 30,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَظِلٍّۢ مَّمْدُودٍۢ",
      "english_translation": "and shade extended,"
    },
    {
      "ayah_reference": "56:31",
      "surah_number": 56,
      "ayah_number": 31,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَمَآءٍۢ مَّسْكُوبٍۢ",
      "english_translation": "and waters gushing,"
    },
    {
      "ayah_reference": "56:32",
      "surah_number": 56,
      "ayah_number": 32,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَفَٰكِهَةٍۢ كَثِيرَةٍۢ",
      "english_translation": "and fruit abounding,"
    },
    {
      "ayah_reference": "56:33",
      "surah_number": 56,
      "ayah_number": 33,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ",
      "english_translation": "never-failing and never out of reach."
    },
    {
      "ayah_reference": "56:34",
      "surah_number": 56,
      "ayah_number": 34,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "وَفُرُشٍۢ مَّرْفُوعَةٍ",
      "english_translation": "And [with them will be their] spouses, raised high:"
    },
    {
      "ayah_reference": "56:35",
      "surah_number": 56,
      "ayah_number": 35,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ",
      "english_translation": "for, behold, We shall have brought them into being in a life renewed,"
    },
    {
      "ayah_reference": "56:36",
      "surah_number": 56,
      "ayah_number": 36,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "فَجَعَلْنَٰهُنَّ أَبْكَارًا",
      "english_translation": "having resurrected them as virgins,"
    },
    {
      "ayah_reference": "56:37",
      "surah_number": 56,
      "ayah_number": 37,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "عُرُبًا أَتْرَابًۭا",
      "english_translation": "full of love, well-matched"
    },
    {
      "ayah_reference": "56:38",
      "surah_number": 56,
      "ayah_number": 38,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "sajda": false,
      "arabic_text": "لِّأَصْحَٰبِ ٱلْيَمِينِ",
      "english_translation": "with those who have attained to righteousness:"
    },
    {
      "ayah_reference": "56:39",
      "surah_number": 56,
      "ayah_number": 39,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ",
      "english_translation": "a good many of olden times,"
    },
    {
      "ayah_reference": "56:40",
      "surah_number": 56,
      "ayah_number": 40,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ",
      "english_translation": "and a good many of later times."
    },
    {
      "ayah_reference": "56:41",
      "surah_number": 56,
      "ayah_number": 41,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ",
      "english_translation": "BUT AS FOR those who have persevered in evil - what of those who have persevered in evil?"
    },
    {
      "ayah_reference": "56:42",
      "surah_number": 56,
      "ayah_number": 42,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "فِى سَمُومٍۢ وَحَمِيمٍۢ",
      "english_translation": "[They will find themselves] in the midst of scorching winds, and burning despair,"
    },
    {
      "ayah_reference": "56:43",
      "surah_number": 56,
      "ayah_number": 43,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "وَظِلٍّۢ مِّن يَحْمُومٍۢ",
      "english_translation": "and the shadows of black smoke -"
    },
    {
      "ayah_reference": "56:44",
      "surah_number": 56,
      "ayah_number": 44,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "لَّا بَارِدٍۢ وَلَا كَرِيمٍ",
      "english_translation": "[shadows] neither cooling nor soothing."
    },
    {
      "ayah_reference": "56:45",
      "surah_number": 56,
      "ayah_number": 45,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
      "english_translation": "For, behold, in times gone by they were wont to abandon themselves wholly to the pursuit of pleasures,"
    },
    {
      "ayah_reference": "56:46",
      "surah_number": 56,
      "ayah_number": 46,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
      "english_translation": "and would persist in heinous sinning,"
    },
    {
      "ayah_reference": "56:47",
      "surah_number": 56,
      "ayah_number": 47,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "english_translation": "and would say, “What! After we have died and become mere dust and bones, shall we, forsooth, be raised from the dead? -"
    },
    {
      "ayah_reference": "56:48",
      "surah_number": 56,
      "ayah_number": 48,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "english_translation": "and perhaps, too, our forebears of old?”"
    },
    {
      "ayah_reference": "56:49",
      "surah_number": 56,
      "ayah_number": 49,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ",
      "english_translation": "Say: “Verily, those of olden times and those of later times"
    },
    {
      "ayah_reference": "56:50",
      "surah_number": 56,
      "ayah_number": 50,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ",
      "english_translation": "will indeed be gathered together at an appointed time on a Day known [only to God]:"
    },
    {
      "ayah_reference": "56:51",
      "surah_number": 56,
      "ayah_number": 51,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
      "english_translation": "and then, verily, O you who have gone astray and called the truth a lie,"
    },
    {
      "ayah_reference": "56:52",
      "surah_number": 56,
      "ayah_number": 52,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ",
      "english_translation": "you will indeed have to taste of the tree of deadly fruit,"
    },
    {
      "ayah_reference": "56:53",
      "surah_number": 56,
      "ayah_number": 53,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
      "english_translation": "and will have to fill your bellies therewith,"
    },
    {
      "ayah_reference": "56:54",
      "surah_number": 56,
      "ayah_number": 54,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
      "english_translation": "and will thereupon have to drink [many a draught] of burning despair -"
    },
    {
      "ayah_reference": "56:55",
      "surah_number": 56,
      "ayah_number": 55,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ",
      "english_translation": "drink it as the most insatiably thirsty camels drink!”"
    },
    {
      "ayah_reference": "56:56",
      "surah_number": 56,
      "ayah_number": 56,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
      "english_translation": "Such will be their welcome on Judgment Day!"
    },
    {
      "ayah_reference": "56:57",
      "surah_number": 56,
      "ayah_number": 57,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
      "english_translation": "WE who have created you, [O men:] why, then, do you not accept the truth?"
    },
    {
      "ayah_reference": "56:58",
      "surah_number": 56,
      "ayah_number": 58,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
      "english_translation": "Have you ever considered that [seed] which you emit?"
    },
    {
      "ayah_reference": "56:59",
      "surah_number": 56,
      "ayah_number": 59,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ",
      "english_translation": "Is it you who create it - or are We the source of its creation?"
    },
    {
      "ayah_reference": "56:60",
      "surah_number": 56,
      "ayah_number": 60,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "english_translation": "We have [indeed] decreed that death shall be [ever-present] among you: but there is nothing to prevent Us"
    },
    {
      "ayah_reference": "56:61",
      "surah_number": 56,
      "ayah_number": 61,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
      "english_translation": "from changing the nature of your existence and bringing you into being [anew] in a manner [as yet] unknown to you."
    },
    {
      "ayah_reference": "56:62",
      "surah_number": 56,
      "ayah_number": 62,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
      "english_translation": "And [since] you are indeed aware of the [miracle of your] coming into being in the first instance - why, then, do you not bethink yourselves [of Us]?"
    },
    {
      "ayah_reference": "56:63",
      "surah_number": 56,
      "ayah_number": 63,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
      "english_translation": "Have you ever considered the seed which you cast upon the soil?"
    },
    {
      "ayah_reference": "56:64",
      "surah_number": 56,
      "ayah_number": 64,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
      "english_translation": "Is it you who cause it to grow - or are We the cause of its growth?"
    },
    {
      "ayah_reference": "56:65",
      "surah_number": 56,
      "ayah_number": 65,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ",
      "english_translation": "[For,] were it Our will, We could indeed turn it into chaff, and you would be left to wonder [and to lament],"
    },
    {
      "ayah_reference": "56:66",
      "surah_number": 56,
      "ayah_number": 66,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "إِنَّا لَمُغْرَمُونَ",
      "english_translation": "“Verily, we are ruined!"
    },
    {
      "ayah_reference": "56:67",
      "surah_number": 56,
      "ayah_number": 67,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "بَلْ نَحْنُ مَحْرُومُونَ",
      "english_translation": "Nay, but we have been deprived [of our livelihood]!”"
    },
    {
      "ayah_reference": "56:68",
      "surah_number": 56,
      "ayah_number": 68,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
      "english_translation": "Have you ever considered the water which you drink?"
    },
    {
      "ayah_reference": "56:69",
      "surah_number": 56,
      "ayah_number": 69,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
      "english_translation": "Is it you who cause it to come down from the clouds - or are We the cause of its coming down?"
    },
    {
      "ayah_reference": "56:70",
      "surah_number": 56,
      "ayah_number": 70,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ",
      "english_translation": "[It comes down sweet - but] were it Our will, We could make it burningly salty and bitter: why, then, do you not give thanks [unto Us]?"
    },
    {
      "ayah_reference": "56:71",
      "surah_number": 56,
      "ayah_number": 71,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
      "english_translation": "Have you ever considered the fire which you kindle?"
    },
    {
      "ayah_reference": "56:72",
      "surah_number": 56,
      "ayah_number": 72,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
      "english_translation": "Is it you who have brought into being the tree that serves as its fuel - or are We the cause of its coming into being?"
    },
    {
      "ayah_reference": "56:73",
      "surah_number": 56,
      "ayah_number": 73,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ",
      "english_translation": "It is We who have made it a means to remind [you of Us], and a comfort for all who are lost and hungry in the wilderness [of their lives]."
    },
    {
      "ayah_reference": "56:74",
      "surah_number": 56,
      "ayah_number": 74,
      "juz": 27,
      "hizb_quarter": 214,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "sajda": false,
      "arabic_text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "english_translation": "Extol, then, the limitless glory of thy Sus­tainer’s mighty name!"
    },
    {
      "ayah_reference": "56:75",
      "surah_number": 56,
      "ayah_number": 75,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 536,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
      "english_translation": "NAY, I call to witness the coming-down in parts [of this Qur’an]"
    },
    {
      "ayah_reference": "56:76",
      "surah_number": 56,
      "ayah_number": 76,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 536,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ",
      "english_translation": "and, behold, this is indeed a most solemn affirmation, if you but knew it!"
    },
    {
      "ayah_reference": "56:77",
      "surah_number": 56,
      "ayah_number": 77,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ",
      "english_translation": "Behold, it is a truly noble discourse,"
    },
    {
      "ayah_reference": "56:78",
      "surah_number": 56,
      "ayah_number": 78,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "فِى كِتَٰبٍۢ مَّكْنُونٍۢ",
      "english_translation": "[conveyed unto man] in a well-guarded divine writ"
    },
    {
      "ayah_reference": "56:79",
      "surah_number": 56,
      "ayah_number": 79,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ",
      "english_translation": "which none but the pure [of heart] can touch:"
    },
    {
      "ayah_reference": "56:80",
      "surah_number": 56,
      "ayah_number": 80,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ",
      "english_translation": "a revelation from the Sustainer of all the worlds!"
    },
    {
      "ayah_reference": "56:81",
      "surah_number": 56,
      "ayah_number": 81,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",
      "english_translation": "Would you, now, look down with disdain on a tiding like this,"
    },
    {
      "ayah_reference": "56:82",
      "surah_number": 56,
      "ayah_number": 82,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",
      "english_translation": "and make it your daily bread [as it were] to call the truth a lie?"
    },
    {
      "ayah_reference": "56:83",
      "surah_number": 56,
      "ayah_number": 83,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ",
      "english_translation": "Why, then, when [the last breath] comes up to the throat [of a dying man],"
    },
    {
      "ayah_reference": "56:84",
      "surah_number": 56,
      "ayah_number": 84,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ",
      "english_translation": "the while you are [helplessly] looking on -"
    },
    {
      "ayah_reference": "56:85",
      "surah_number": 56,
      "ayah_number": 85,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ",
      "english_translation": "and while We are closer to him than you, although you see [Us] not -:"
    },
    {
      "ayah_reference": "56:86",
      "surah_number": 56,
      "ayah_number": 86,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ",
      "english_translation": "why, then, if [you think that] you are not truly dependent [on Us],"
    },
    {
      "ayah_reference": "56:87",
      "surah_number": 56,
      "ayah_number": 87,
      "juz": 27,
      "hizb_quarter": 215,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "sajda": false,
      "arabic_text": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ",
      "english_translation": "can you not cause that [ebbing life] to return - if what you claim is true?"
    },
    {
      "ayah_reference": "56:88",
      "surah_number": 56,
      "ayah_number": 88,
      "juz": 27,
