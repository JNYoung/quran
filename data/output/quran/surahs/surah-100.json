{
  "surah_number": 100,
  "surah_name_arabic": "سُورَةُ العَادِيَاتِ",
  "surah_name_english": "Al-Aadiyaat",
  "surah_name_english_translation": "The Chargers",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "100:1",
      "surah_number": 100,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا",
      "english_translation": "Oh, the chargers that run panting,"
    },
    {
      "ayah_reference": "100:2",
      "surah_number": 100,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "فَٱلْمُورِيَٰتِ قَدْحًۭا",
      "english_translation": "sparks of fire striking,"
    },
    {
      "ayah_reference": "100:3",
      "surah_number": 100,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "فَٱلْمُغِيرَٰتِ صُبْحًۭا",
      "english_translation": "rushing to assault at morn,"
    },
    {
      "ayah_reference": "100:4",
      "surah_number": 100,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "فَأَثَرْنَ بِهِۦ نَقْعًۭا",
      "english_translation": "thereby raising clouds of dust,"
    },
    {
      "ayah_reference": "100:5",
      "surah_number": 100,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "english_translation": "thereby storming [blindly] into any host!"
    },
    {
      "ayah_reference": "100:6",
      "surah_number": 100,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ",
      "english_translation": "VERILY, towards his Sustainer man is most ungrateful"
    },
    {
      "ayah_reference": "100:7",
      "surah_number": 100,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ",
      "english_translation": "and to this, behold, he [himself] bears witness indeed:"
    },
    {
      "ayah_reference": "100:8",
      "surah_number": 100,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 239,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "english_translation": "for, verily, to the love of wealth is he most ardently devoted."
    },
    {
      "ayah_reference": "100:9",
      "surah_number": 100,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "english_translation": "But does he not know that [on the Last Day,] when all that is in the graves is raised and brought out,"
    },
    {
      "ayah_reference": "100:10",
      "surah_number": 100,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "english_translation": "and all that is [hidden] in men's hearts is bared"
    },
    {
      "ayah_reference": "100:11",
      "surah_number": 100,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 240,
      "manzil": 7,
      "page": 600,
      "ruku": 542,
      "sajda": false,
      "arabic_text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ",
      "english_translation": "that on that Day their Sustainer [will show that He] has always been fully aware of them?"
    }
  ]
}