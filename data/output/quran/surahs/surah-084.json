{
  "surah_number": 84,
  "surah_name_arabic": "سُورَةُ الانشِقَاقِ",
  "surah_name_english": "Al-Inshiqaaq",
  "surah_name_english_translation": "The Splitting Open",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "84:1",
      "surah_number": 84,
      "ayah_number": 1,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
      "english_translation": "WHEN THE SKY is split asunder,"
    },
    {
      "ayah_reference": "84:2",
      "surah_number": 84,
      "ayah_number": 2,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "english_translation": "obeying its Sustainer, as in truth it must;"
    },
    {
      "ayah_reference": "84:3",
      "surah_number": 84,
      "ayah_number": 3,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
      "english_translation": "and when the earth is leveled,"
    },
    {
      "ayah_reference": "84:4",
      "surah_number": 84,
      "ayah_number": 4,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "english_translation": "and casts forth whatever is in it, and becomes utterly void,"
    },
    {
      "ayah_reference": "84:5",
      "surah_number": 84,
      "ayah_number": 5,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "english_translation": "obeying its Sustainer, as in truth it must -:"
    },
    {
      "ayah_reference": "84:6",
      "surah_number": 84,
      "ayah_number": 6,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ",
      "english_translation": "[then,] O man - thou [that] hast, verily, been toiling towards thy Sustainer in painful toil - then shalt thou meet Him!"
    },
    {
      "ayah_reference": "84:7",
      "surah_number": 84,
      "ayah_number": 7,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
      "english_translation": "And as for him whose record shall be placed in his right hand,"
    },
    {
      "ayah_reference": "84:8",
      "surah_number": 84,
      "ayah_number": 8,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا",
      "english_translation": "he will in time be called to account with an easy accounting,"
    },
    {
      "ayah_reference": "84:9",
      "surah_number": 84,
      "ayah_number": 9,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا",
      "english_translation": "and will [be able to] turn joyfully to those of his own kind."
    },
    {
      "ayah_reference": "84:10",
      "surah_number": 84,
      "ayah_number": 10,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
      "english_translation": "But as for him whose record shall be given to him behind his back;"
    },
    {
      "ayah_reference": "84:11",
      "surah_number": 84,
      "ayah_number": 11,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا",
      "english_translation": "he will in time pray for utter destruction:"
    },
    {
      "ayah_reference": "84:12",
      "surah_number": 84,
      "ayah_number": 12,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَيَصْلَىٰ سَعِيرًا",
      "english_translation": "but he will enter the blazing flame."
    },
    {
      "ayah_reference": "84:13",
      "surah_number": 84,
      "ayah_number": 13,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
      "english_translation": "Behold, [in his earthly life] he lived joyfully among people of his own kind"
    },
    {
      "ayah_reference": "84:14",
      "surah_number": 84,
      "ayah_number": 14,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
      "english_translation": "for, behold, he never thought that he would have to return [to God]."
    },
    {
      "ayah_reference": "84:15",
      "surah_number": 84,
      "ayah_number": 15,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا",
      "english_translation": "Yea indeed! His Sustainer did see all that was in him!"
    },
    {
      "ayah_reference": "84:16",
      "surah_number": 84,
      "ayah_number": 16,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
      "english_translation": "BUT NAY! I call to witness the sunset's [fleeting] afterglow,"
    },
    {
      "ayah_reference": "84:17",
      "surah_number": 84,
      "ayah_number": 17,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَٱلَّيْلِ وَمَا وَسَقَ",
      "english_translation": "and the night, and what it [step by step] unfolds,"
    },
    {
      "ayah_reference": "84:18",
      "surah_number": 84,
      "ayah_number": 18,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
      "english_translation": "and the moon, as it grows to its fullness:"
    },
    {
      "ayah_reference": "84:19",
      "surah_number": 84,
      "ayah_number": 19,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ",
      "english_translation": "[even thus, O men,] are you bound to move; onward from stage to stage."
    },
    {
      "ayah_reference": "84:20",
      "surah_number": 84,
      "ayah_number": 20,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
      "english_translation": "What, then, is amiss with them that they will not believe [in a life to come]?"
    },
    {
      "ayah_reference": "84:21",
      "surah_number": 84,
      "ayah_number": 21,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": {
        "id": 14,
        "recommended": true,
        "obligatory": false
      },
      "arabic_text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
      "english_translation": "and [that], when the Qur’an is read unto them, they do not fall down in prostration?"
    },
    {
      "ayah_reference": "84:22",
      "surah_number": 84,
      "ayah_number": 22,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
      "english_translation": "Nay, but they who are bent on denying the truth give the lie [to this divine writ]!"
    },
    {
      "ayah_reference": "84:23",
      "surah_number": 84,
      "ayah_number": 23,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
      "english_translation": "Yet God has full knowledge of what they conceal [in their hearts]."
    },
    {
      "ayah_reference": "84:24",
      "surah_number": 84,
      "ayah_number": 24,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
      "english_translation": "Hence, give them the tiding of grievous suffering [in the life to come] –"
    },
    {
      "ayah_reference": "84:25",
      "surah_number": 84,
      "ayah_number": 25,
      "juz": 30,
      "hizb_quarter": 236,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "sajda": false,
      "arabic_text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
      "english_translation": "unless it be such [of them] as [repent, and] attain to faith, and do good works: for theirs shall be a reward unending!."
    }
  ]
}