      "ayah_reference": "53:57",
      "surah_number": 53,
      "ayah_number": 57,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "أَزِفَتِ ٱلْءَازِفَةُ",
      "english_translation": "that [Last Hour] which is so near draws ever nearer,"
    },
    {
      "ayah_reference": "53:58",
      "surah_number": 53,
      "ayah_number": 58,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ",
