      "surah_number": 53,
      "ayah_number": 51,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ",
