      "surah_number": 53,
      "ayah_number": 46,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ",
      "english_translation": "out of a [mere] drop of sperm as it is poured forth,"
