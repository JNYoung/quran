      "surah_number": 53,
      "ayah_number": 62,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": {
        "id": 13,
        "recommended": false,
        "obligatory": true
      },
      "arabic_text": "فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩",
      "english_translation": "[Nay,] but prostrate yourselves before God, and worship [Him alone]!"
