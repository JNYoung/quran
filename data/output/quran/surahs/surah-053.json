      "ayah_number": 61,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَنتُمْ سَٰمِدُونَ",
      "english_translation": "and divert yourselves all the while?"
    },
