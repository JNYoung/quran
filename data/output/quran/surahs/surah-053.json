      "surah_number": 53,
      "ayah_number": 38,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "أَلَّا تَزِرُ وَازِرَةٌۭ وِزْرَ أُخْرَىٰ",
      "english_translation": "that no bearer of burdens shall be made to bear another’s burden;"
    },
    {
      "ayah_reference": "53:39",
      "surah_number": 53,
      "ayah_number": 39,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَن لَّيْسَ لِلْإِنسَٰنِ إِلَّا مَا سَعَىٰ",
      "english_translation": "and that nought shall be accounted unto man but what he is striving for;"
    },
    {
      "ayah_reference": "53:40",
      "surah_number": 53,
      "ayah_number": 40,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ",
      "english_translation": "and that in time [the nature of] all his striving will be shown [to him in its true light],"
    },
    {
      "ayah_reference": "53:41",
      "surah_number": 53,
      "ayah_number": 41,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ",
      "english_translation": "where­upon he shall be requited for it with the fullest requital;"
    },
    {
      "ayah_reference": "53:42",
      "surah_number": 53,
      "ayah_number": 42,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ",
      "english_translation": "and that with thy Sustainer is the beginning and the end [of all that exists];"
    },
    {
      "ayah_reference": "53:43",
      "surah_number": 53,
      "ayah_number": 43,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ",
      "english_translation": "and that it is He alone who causes [you] to laugh and to weep;"
    },
    {
      "ayah_reference": "53:44",
      "surah_number": 53,
      "ayah_number": 44,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا",
      "english_translation": "and that it is He alone who deals death and grants life;"
    },
