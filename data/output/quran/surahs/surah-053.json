    },
    {
      "ayah_reference": "53:49",
      "surah_number": 53,
      "ayah_number": 49,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ",
