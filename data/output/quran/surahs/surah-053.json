    },
    {
      "ayah_reference": "53:50",
      "surah_number": 53,
      "ayah_number": 50,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ",
