    {
      "ayah_reference": "53:59",
      "surah_number": 53,
      "ayah_number": 59,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "أَفَمِنْ هَٰذَا ٱلْحَدِيثِ تَعْجَبُونَ",
      "english_translation": "Do you, perchance, find this tiding strange?"
    },
