{
  "surah_number": 53,
  "surah_name_arabic": "سُورَةُ النَّجۡمِ",
  "surah_name_english": "An-Najm",
  "surah_name_english_translation": "The Star",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "53:1",
      "surah_number": 53,
      "ayah_number": 1,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّجْمِ إِذَا هَوَىٰ",
      "english_translation": "CONSIDER this unfolding [of God’s message], as it comes down from on high!"
    },
    {
      "ayah_reference": "53:2",
      "surah_number": 53,
      "ayah_number": 2,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ",
      "english_translation": "This fellow-man of yours has not gone astray, nor is he deluded,"
    },
    {
      "ayah_reference": "53:3",
      "surah_number": 53,
      "ayah_number": 3,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ",
      "english_translation": "and neither does he speak out of his own desire:"
    },
    {
      "ayah_reference": "53:4",
      "surah_number": 53,
      "ayah_number": 4,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "إِنْ هُوَ إِلَّا وَحْىٌۭ يُوحَىٰ",
      "english_translation": "that [which he conveys to you] is but [a divine] inspiration with which he is being inspired –"
    },
    {
      "ayah_reference": "53:5",
      "surah_number": 53,
      "ayah_number": 5,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ",
      "english_translation": "something that a very mighty one has imparted to him:"
    },
    {
      "ayah_reference": "53:6",
      "surah_number": 53,
      "ayah_number": 6,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "ذُو مِرَّةٍۢ فَٱسْتَوَىٰ",
      "english_translation": "[an angel] endowed with sur­passing power, who in time manifested himself in his true shape and nature,"
    },
    {
      "ayah_reference": "53:7",
      "surah_number": 53,
      "ayah_number": 7,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ",
      "english_translation": "appearing in the horizon’s loftiest part,"
    },
    {
      "ayah_reference": "53:8",
      "surah_number": 53,
      "ayah_number": 8,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "ثُمَّ دَنَا فَتَدَلَّىٰ",
      "english_translation": "and then drew near, and came close,"
    },
    {
      "ayah_reference": "53:9",
      "surah_number": 53,
      "ayah_number": 9,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ",
      "english_translation": "until he was but two bow-lengths away, or even nearer."
    },
    {
      "ayah_reference": "53:10",
      "surah_number": 53,
      "ayah_number": 10,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ",
      "english_translation": "And thus did [God] reveal unto His servant whatever He deemed right to reveal."
    },
    {
      "ayah_reference": "53:11",
      "surah_number": 53,
      "ayah_number": 11,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ",
      "english_translation": "The [servant’s] heart did not give the lie to what he saw:"
    },
    {
      "ayah_reference": "53:12",
      "surah_number": 53,
      "ayah_number": 12,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ",
      "english_translation": "will you, then, contend with him as to what he saw?"
    },
    {
      "ayah_reference": "53:13",
      "surah_number": 53,
      "ayah_number": 13,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ",
      "english_translation": "And, indeed, he saw him a second time"
    },
    {
      "ayah_reference": "53:14",
      "surah_number": 53,
      "ayah_number": 14,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ",
      "english_translation": "by the lote-tree of the farthest limit,"
    },
    {
      "ayah_reference": "53:15",
      "surah_number": 53,
      "ayah_number": 15,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ",
      "english_translation": "near unto the garden of promise."
    },
    {
      "ayah_reference": "53:16",
      "surah_number": 53,
      "ayah_number": 16,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ",
      "english_translation": "with the lote-tree veiled in a veil of nameless splendour…."
    },
    {
      "ayah_reference": "53:17",
      "surah_number": 53,
      "ayah_number": 17,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ",
      "english_translation": "[And withal,] the eye did not waver, nor yet did it stray:"
    },
    {
      "ayah_reference": "53:18",
      "surah_number": 53,
      "ayah_number": 18,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ",
      "english_translation": "truly did he see some of the most profound of his Sustainer’s symbols."
    },
    {
      "ayah_reference": "53:19",
      "surah_number": 53,
      "ayah_number": 19,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ",
      "english_translation": "HAVE YOU, then, ever considered [what you are worshipping in] Al-Lat and Al-Uzza,"
    },
    {
      "ayah_reference": "53:20",
      "surah_number": 53,
      "ayah_number": 20,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ",
      "english_translation": "as well as [in] Manat, the third and last [of this triad]?"
    },
    {
      "ayah_reference": "53:21",
      "surah_number": 53,
      "ayah_number": 21,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ",
      "english_translation": "Why - for yourselves [you would choose only] male offspring, whereas to Him [you assign] female:"
    },
    {
      "ayah_reference": "53:22",
      "surah_number": 53,
      "ayah_number": 22,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "تِلْكَ إِذًۭا قِسْمَةٌۭ ضِيزَىٰٓ",
      "english_translation": "that, lo and behold, is an unfair division!"
    },
    {
      "ayah_reference": "53:23",
      "surah_number": 53,
      "ayah_number": 23,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "إِنْ هِىَ إِلَّآ أَسْمَآءٌۭ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ",
      "english_translation": "These [allegedly divine beings] are nothing but empty names which you have invented - you and your forefathers - [and] for which God has bestowed no warrant from on high. They [who worship them] follow nothing but surmise and their own wishful thinking - although right guidance has now indeed come unto them from their Sustainer."
    },
    {
      "ayah_reference": "53:24",
      "surah_number": 53,
      "ayah_number": 24,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ",
      "english_translation": "Does man imagine that it is his due to have all that he might wish for,"
    },
    {
      "ayah_reference": "53:25",
      "surah_number": 53,
      "ayah_number": 25,
      "juz": 27,
      "hizb_quarter": 210,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "sajda": false,
      "arabic_text": "فَلِلَّهِ ٱلْءَاخِرَةُ وَٱلْأُولَىٰ",
      "english_translation": "despite the fact that [both] the life to come and this present [one] belong to God [alone]?"
    },
    {
      "ayah_reference": "53:26",
      "surah_number": 53,
      "ayah_number": 26,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 526,
      "ruku": 461,
      "sajda": false,
      "arabic_text": "۞ وَكَم مِّن مَّلَكٍۢ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ",
      "english_translation": "For, however many angels there be in the heavens, their intercession can be of no least avail [to anyone] - except after God has given leave [to inter­cede] for whomever He wills and with whom He is well-pleased."
    },
    {
      "ayah_reference": "53:27",
      "surah_number": 53,
      "ayah_number": 27,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 461,
      "sajda": false,
      "arabic_text": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ لَيُسَمُّونَ ٱلْمَلَٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ",
      "english_translation": "Behold, it is [only] such as do not [really] believe in the life to come that regard the angels as female beings;"
    },
    {
      "ayah_reference": "53:28",
      "surah_number": 53,
      "ayah_number": 28,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 461,
      "sajda": false,
      "arabic_text": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًۭٔا",
      "english_translation": "and [since] they have no knowledge whatever thereof, they follow nothing but surmise: yet, behold, never can surmise take the place of truth."
    },
    {
      "ayah_reference": "53:29",
      "surah_number": 53,
      "ayah_number": 29,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 461,
      "sajda": false,
      "arabic_text": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "english_translation": "Avoid thou, therefore, those who turn away from all remembrance of Us and care for no more than the life of this world,"
    },
    {
      "ayah_reference": "53:30",
      "surah_number": 53,
      "ayah_number": 30,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 461,
      "sajda": false,
      "arabic_text": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ",
      "english_translation": "which, to them, is the only thing worth knowing. Behold, thy Sustainer is fully aware as to who has strayed from His path, and fully aware is He as to who follows His guidance."
    },
    {
      "ayah_reference": "53:31",
      "surah_number": 53,
      "ayah_number": 31,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 461,
      "sajda": false,
      "arabic_text": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",
      "english_translation": "Indeed, unto God belongs all that is in the heavens and all that is on earth: and so He will reward those who do evil in accordance with what they did, and will reward those who do good with ultimate good."
    },
    {
      "ayah_reference": "53:32",
      "surah_number": 53,
      "ayah_number": 32,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 461,
      "sajda": false,
      "arabic_text": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌۭ فِى بُطُونِ أُمَّهَٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ",
      "english_translation": "As for those who avoid the [truly] grave sins and shameful deeds - even though they may some­times stumble behold, thy Sustainer is abounding in forgiveness. He is fully aware of you when He brings you into being out of dust, and when you are still hidden in your mothers’ wombs: do not, then, consider your­selves pure - [for] He knows best as to who is conscious of Him."
    },
    {
      "ayah_reference": "53:33",
      "surah_number": 53,
      "ayah_number": 33,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ",
      "english_translation": "HAST THOU, then, ever considered him who turns away [from remembering Us, and cares for no more than the life of this world],"
    },
    {
      "ayah_reference": "53:34",
      "surah_number": 53,
      "ayah_number": 34,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَأَعْطَىٰ قَلِيلًۭا وَأَكْدَىٰٓ",
      "english_translation": "and gives so little [of himself for the good of his soul], and so grudgingly?"
    },
    {
      "ayah_reference": "53:35",
      "surah_number": 53,
      "ayah_number": 35,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ",
      "english_translation": "Does he [claim to] have knowledge of some­thing that is beyond the reach of human perception, so that he can see [it clearly]?"
    },
    {
      "ayah_reference": "53:36",
      "surah_number": 53,
      "ayah_number": 36,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ",
      "english_translation": "Or has he never yet been told of what was [said] in the revelations of Moses,"
    },
    {
      "ayah_reference": "53:37",
      "surah_number": 53,
      "ayah_number": 37,
      "juz": 27,
      "hizb_quarter": 211,
      "manzil": 7,
      "page": 527,
      "ruku": 462,
      "sajda": false,
      "arabic_text": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ",
      "english_translation": "and of Abra­ham, who to his trust was true:"
    },
    {
