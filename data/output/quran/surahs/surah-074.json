{
  "surah_number": 74,
  "surah_name_arabic": "سُورَةُ المُدَّثِّرِ",
  "surah_name_english": "Al-Muddaththir",
  "surah_name_english_translation": "The Cloaked One",
  "revelation_type": "Meccan",
  "ayahs": [
    {
      "ayah_reference": "74:1",
      "surah_number": 74,
      "ayah_number": 1,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ",
      "english_translation": "O THOU [in thy solitude] enfolded!"
    },
    {
      "ayah_reference": "74:2",
      "surah_number": 74,
      "ayah_number": 2,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "قُمْ فَأَنذِرْ",
      "english_translation": "Arise and warn!"
    },
    {
      "ayah_reference": "74:3",
      "surah_number": 74,
      "ayah_number": 3,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَرَبَّكَ فَكَبِّرْ",
      "english_translation": "And thy Sustainer's greatness glorify!"
    },
    {
      "ayah_reference": "74:4",
      "surah_number": 74,
      "ayah_number": 4,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَثِيَابَكَ فَطَهِّرْ",
      "english_translation": "And thine inner self purify!"
    },
    {
      "ayah_reference": "74:5",
      "surah_number": 74,
      "ayah_number": 5,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَٱلرُّجْزَ فَٱهْجُرْ",
      "english_translation": "And all defilement shun!"
    },
    {
      "ayah_reference": "74:6",
      "surah_number": 74,
      "ayah_number": 6,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَلَا تَمْنُن تَسْتَكْثِرُ",
      "english_translation": "And do not through giving seek thyself to gain,"
    },
    {
      "ayah_reference": "74:7",
      "surah_number": 74,
      "ayah_number": 7,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَلِرَبِّكَ فَٱصْبِرْ",
      "english_translation": "but unto thy Sustainer turn in patience."
    },
    {
      "ayah_reference": "74:8",
      "surah_number": 74,
      "ayah_number": 8,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ",
      "english_translation": "And [warn all men that] when the trumpet-call [of resurrection] is sounded,"
    },
    {
      "ayah_reference": "74:9",
      "surah_number": 74,
      "ayah_number": 9,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "فَذَٰلِكَ يَوْمَئِذٍۢ يَوْمٌ عَسِيرٌ",
      "english_translation": "that very Day shall be a day of anguish,"
    },
    {
      "ayah_reference": "74:10",
      "surah_number": 74,
      "ayah_number": 10,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍۢ",
      "english_translation": "not of ease, for all who [now] deny the truth!"
    },
    {
      "ayah_reference": "74:11",
      "surah_number": 74,
      "ayah_number": 11,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًۭا",
      "english_translation": "LEAVE Me alone [to deal] with him whom I have created alone,"
    },
    {
      "ayah_reference": "74:12",
      "surah_number": 74,
      "ayah_number": 12,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَجَعَلْتُ لَهُۥ مَالًۭا مَّمْدُودًۭا",
      "english_translation": "and to whom I have granted resources vast,"
    },
    {
      "ayah_reference": "74:13",
      "surah_number": 74,
      "ayah_number": 13,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَبَنِينَ شُهُودًۭا",
      "english_translation": "and children as [love's] witnesses,"
    },
    {
      "ayah_reference": "74:14",
      "surah_number": 74,
      "ayah_number": 14,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًۭا",
      "english_translation": "and to whose life I gave so wide a scope:"
    },
    {
      "ayah_reference": "74:15",
      "surah_number": 74,
      "ayah_number": 15,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ",
      "english_translation": "and yet, he greedily desires that I give yet more!"
    },
    {
      "ayah_reference": "74:16",
      "surah_number": 74,
      "ayah_number": 16,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِءَايَٰتِنَا عَنِيدًۭا",
      "english_translation": "Nay, verily, it is against Our messages that he knowingly, stubbornly sets himself"
    },
    {
      "ayah_reference": "74:17",
      "surah_number": 74,
      "ayah_number": 17,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "سَأُرْهِقُهُۥ صَعُودًا",
      "english_translation": "[and so] I shall constrain him to endure a painful uphill climb!"
    },
    {
      "ayah_reference": "74:18",
      "surah_number": 74,
      "ayah_number": 18,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ",
      "english_translation": "Behold, [when Our messages are conveyed to one who is bent on denying the truth,] he reflects and meditates [as to how to disprove them] –"
    },
    {
      "ayah_reference": "74:19",
      "surah_number": 74,
      "ayah_number": 19,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "فَقُتِلَ كَيْفَ قَدَّرَ",
      "english_translation": "and thus he destroys himself, the way he meditates:"
    },
    {
      "ayah_reference": "74:20",
      "surah_number": 74,
      "ayah_number": 20,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ",
      "english_translation": "yea, he destroys himself, the way he meditates!"
    },
    {
      "ayah_reference": "74:21",
      "surah_number": 74,
      "ayah_number": 21,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "ثُمَّ نَظَرَ",
      "english_translation": "and then he looks [around for new arguments],"
    },
    {
      "ayah_reference": "74:22",
      "surah_number": 74,
      "ayah_number": 22,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "ثُمَّ عَبَسَ وَبَسَرَ",
      "english_translation": "and then he frowns and glares,"
    },
    {
      "ayah_reference": "74:23",
      "surah_number": 74,
      "ayah_number": 23,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ",
      "english_translation": "and in the end he turns his back [on Our message], and glories in his arrogance,"
    },
    {
      "ayah_reference": "74:24",
      "surah_number": 74,
      "ayah_number": 24,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ يُؤْثَرُ",
      "english_translation": "and says, \"All this is mere spellbinding eloquence handed down [from olden times]!"
    },
    {
      "ayah_reference": "74:25",
      "surah_number": 74,
      "ayah_number": 25,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "إِنْ هَٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ",
      "english_translation": "This is nothing but the word of mortal man!\""
    },
    {
      "ayah_reference": "74:26",
      "surah_number": 74,
      "ayah_number": 26,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "سَأُصْلِيهِ سَقَرَ",
      "english_translation": "[Hence,] I shall cause him to endure hell-fire [in the life to come]!"
    },
    {
      "ayah_reference": "74:27",
      "surah_number": 74,
      "ayah_number": 27,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ",
      "english_translation": "And what could make thee conceive what hell-fire is?"
    },
    {
      "ayah_reference": "74:28",
      "surah_number": 74,
      "ayah_number": 28,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "لَا تُبْقِى وَلَا تَذَرُ",
      "english_translation": "It does not allow to live, and neither leaves [to die],"
    },
    {
      "ayah_reference": "74:29",
      "surah_number": 74,
      "ayah_number": 29,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "لَوَّاحَةٌۭ لِّلْبَشَرِ",
      "english_translation": "making [all truth] visible to mortal man."
    },
    {
      "ayah_reference": "74:30",
      "surah_number": 74,
      "ayah_number": 30,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "عَلَيْهَا تِسْعَةَ عَشَرَ",
      "english_translation": "Over it are nineteen [powers]."
    },
    {
      "ayah_reference": "74:31",
      "surah_number": 74,
      "ayah_number": 31,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "sajda": false,
      "arabic_text": "وَمَا جَعَلْنَآ أَصْحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَٰنًۭا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌۭ وَٱلْكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ",
      "english_translation": "For We have caused none but angelic powers to lord over the fire [of hell]; and We have not caused their number to be aught but a trial for those who are bent on denying the truth - to the end that they who have been granted revelation aforetime might be convinced [of the truth of this divine writ]; and that they who have attained to faith [in it] might grow yet more firm in their faith; and that [both] they who have been granted the earlier revelation and they who believe [in this one] might be freed of all doubt; and that they in whose hearts is disease and the who deny the truth outright might ask, \"What does [your] God mean by this parable?\" In this way God lets go astray him that wills [to go astray], and guides aright him that wills [to be guided]. And none can comprehend thy Sustainers forces save Him alone: and all this is but a reminder to mortal man."
    },
    {
      "ayah_reference": "74:32",
      "surah_number": 74,
      "ayah_number": 32,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "كَلَّا وَٱلْقَمَرِ",
      "english_translation": "NAY, but consider the moon!"
    },
    {
      "ayah_reference": "74:33",
      "surah_number": 74,
      "ayah_number": 33,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "وَٱلَّيْلِ إِذْ أَدْبَرَ",
      "english_translation": "Consider the night when it departs,"
    },
    {
      "ayah_reference": "74:34",
      "surah_number": 74,
      "ayah_number": 34,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ",
      "english_translation": "and the morn when it dawns!"
    },
    {
      "ayah_reference": "74:35",
      "surah_number": 74,
      "ayah_number": 35,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ",
      "english_translation": "Verily, that [hell-fire) is Indeed one of the great [forewarnings] –"
    },
    {
      "ayah_reference": "74:36",
      "surah_number": 74,
      "ayah_number": 36,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "نَذِيرًۭا لِّلْبَشَرِ",
      "english_translation": "a warning to mortal man –"
    },
    {
      "ayah_reference": "74:37",
      "surah_number": 74,
      "ayah_number": 37,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ",
      "english_translation": "to everyone of you, whether he chooses to come forward or to hang back!"
    },
    {
      "ayah_reference": "74:38",
      "surah_number": 74,
      "ayah_number": 38,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ",
      "english_translation": "[On the Day of Judgment,] every human being will be held in pledge for whatever [evil] he has wrought –"
    },
    {
      "ayah_reference": "74:39",
      "surah_number": 74,
      "ayah_number": 39,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ",
      "english_translation": "save those who shall have attained to righteousness:"
    },
    {
      "ayah_reference": "74:40",
      "surah_number": 74,
      "ayah_number": 40,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "فِى جَنَّٰتٍۢ يَتَسَآءَلُونَ",
      "english_translation": "[dwelling] In gardens [of paradise], they will inquire"
    },
    {
      "ayah_reference": "74:41",
      "surah_number": 74,
      "ayah_number": 41,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "عَنِ ٱلْمُجْرِمِينَ",
      "english_translation": "of those who were lost in sin:"
    },
    {
      "ayah_reference": "74:42",
      "surah_number": 74,
      "ayah_number": 42,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "مَا سَلَكَكُمْ فِى سَقَرَ",
      "english_translation": "\"What has brought you into hell-fire?\""
    },
    {
      "ayah_reference": "74:43",
      "surah_number": 74,
      "ayah_number": 43,
      "juz": 29,
      "hizb_quarter": 230,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "sajda": false,
      "arabic_text": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ",
